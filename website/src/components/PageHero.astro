---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">{eyebrow}</span>
    <h1 set:html={title}></h1>
    <p>{description}</p>
  </div>
</section>
