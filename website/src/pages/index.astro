---
import SiteLayout from '../layouts/SiteLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AppButtons from '../components/AppButtons.astro';
---
<SiteLayout title="TRYP — Move smarter. Go anywhere." description="TRYP brings safe, reliable and affordable rides to everyday movement in Limpopo, South Africa." path="/">
  <section class="container hero">
    <div class="hero-copy">
      <span class="eyebrow">Local rides. Real connection.</span>
      <h1>Move smarter.<br /><em>Go anywhere.</em></h1>
      <p class="hero-lead">TRYP is your everyday ride-hailing app. Safe, reliable and affordable rides at your fingertips.</p>
      <div class="hero-actions">
        <a class="button button-red" href="/ride/">Book a ride <span aria-hidden="true">→</span></a>
        <a class="button button-outline" href="/drive/">Drive with TRYP <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero-note"><span class="status-dot"></span> Now rolling out in Limpopo, South Africa</p>
    </div>
    <div class="hero-visual" role="img" aria-label="TRYP vehicle travelling along a red and black road">
      <span class="skyline"></span>
      <span class="visual-badge">✦ Built for here</span>
      <span class="pin-large"><span>T</span></span>
      <span class="hero-road-line"></span>
      <span class="car-illustration" aria-hidden="true"></span>
      <div class="visual-card"><small>TRYP journey</small><strong>Tzaneen → Polokwane</strong></div>
    </div>
  </section>

  <section class="container trust-strip" aria-label="TRYP benefits">
    <div class="trust-inner">
      <div class="trust-item"><span class="trust-icon">⚡</span><span><strong>Quick rides</strong><span>Get moving in minutes</span></span></div>
      <div class="trust-item"><span class="trust-icon">♢</span><span><strong>Trusted drivers</strong><span>Verified and local</span></span></div>
      <div class="trust-item"><span class="trust-icon">▣</span><span><strong>Clear fares</strong><span>Know what to expect</span></span></div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading eyebrow="The TRYP difference" title={'Less friction.<br /><span class="soft">More moving.</span>'} description="Whether you are crossing town, heading home, or building your next opportunity, TRYP keeps the journey clear." />
    <div class="feature-grid">
      <FeatureCard icon="⌖" title="Door-to-door, made simple" text="Set your pickup, choose your destination, and see the journey clearly from start to finish." href="/ride/" tone="red" />
      <FeatureCard icon="◷" title="When you need it" text="Request a ride now or schedule ahead when the day needs a little more planning." href="/ride/" tone="blue" />
      <FeatureCard icon="♢" title="A ride you can trust" text="Stay informed with driver details, trip status, and support when you need it." href="/safety/" tone="gold" />
    </div>
  </section>

  <section class="dark-section">
    <div class="container section dark-split">
      <div class="dark-copy">
        <span class="eyebrow">For passengers and drivers</span>
        <h2>Technology that feels<br /><em>human.</em></h2>
        <p>TRYP is being built close to the communities it serves. Practical features, straightforward support, and a service that respects your time.</p>
        <a class="button button-red" href="/about/">Why TRYP exists <span>→</span></a>
      </div>
      <div class="phone-panel" aria-label="Illustration of the TRYP passenger app">
        <div class="phone"><div class="phone-screen"><span class="phone-label">Good morning, Bresley</span><span class="phone-search">⌕ Where to?</span><span class="phone-action">Confirm ride</span></div></div>
        <ul class="check-list">
          <li>Request now or schedule ahead</li>
          <li>Follow your trip in real time</li>
          <li>See clear driver and ride details</li>
          <li>Choose when you go online as a driver</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="route-section">
    <div class="container section">
      <SectionHeading eyebrow="Long-distance rides" title={'Go further with<br /><span class="soft">TRYP.</span>'} description="Find available seats on intercity routes and make the longer journey easier to plan." />
      <div class="route-panel" style="margin-top: 56px;">
        <div class="route-map" role="img" aria-label="Route map from Tzaneen to The Oaks">
          <span class="route-path"></span><span class="route-pin start"><span>T</span></span><span class="route-pin finish"><span>T</span></span>
          <span class="route-label start">Tzaneen, Limpopo</span><span class="route-label finish">The Oaks</span>
        </div>
        <div>
          <span class="eyebrow">Travel together</span>
          <h2 style="margin-top: 18px;">More miles.<br /><em>More possibility.</em></h2>
          <p class="hero-lead">Drivers can post intercity trips, and passengers can reserve a seat with secure card payment. Simple planning for the road ahead.</p>
          <div class="actions"><a class="button button-red" href="/ride/">Explore rides <span>→</span></a><a class="button button-outline" href="/drive/">Post a trip <span>→</span></a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading eyebrow="Choose your TRYP" title={'A clear journey,<br /><span class="soft">all the way.</span>'} description="Simple tools for everyday movement, whether you are taking a trip or making one possible." />
    <div class="ride-options">
      <article class="ride-option"><h3>TRYP <span>GO</span></h3><p>Affordable everyday rides around town.</p><span class="price">Everyday <small>movement</small></span></article>
      <article class="ride-option"><h3>TRYP <span>COMFORT</span></h3><p>More comfort and space when you need it.</p><span class="price">More <small>room</small></span></article>
      <article class="ride-option"><h3>TRYP <span>LONG DISTANCE</span></h3><p>Intercity seats for the road ahead.</p><span class="price">Go <small>further</small></span></article>
    </div>
    <div class="app-banner" id="download" style="margin-top: 16px;">
      <div><h3>Download the TRYP app</h3><p>Your ride, your way. Store links will be added before public launch.</p></div>
      <AppButtons />
    </div>
  </section>
</SiteLayout>
