---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';

interface SafetySection { number: number; title: string; body: string; priority?: string; }

const rawSections: [number, string, string, string?][] = [
  [1, 'Purpose', 'This Safety & Emergency Response Policy establishes the safety standards, emergency procedures and response framework applicable to the TRYP platform. TRYP connects Passengers with Drivers; it is not a police service, ambulance service, security company or emergency medical service. The policy addresses accidents, medical emergencies, assault, robbery, hijacking, threats, sexual misconduct, missing or stranded people, Driver emergencies, breakdowns, dangerous driving, suspicious activity and other serious incidents.'],
  [2, 'Safety principle', '<blockquote>Human life takes priority over the Trip.</blockquote><p>No Fare, rating, cancellation, incentive, delivery or commercial objective is more important than the safety of a person.</p>'],
  [3, 'Who this policy protects', 'This policy applies to Passengers, Drivers, Vehicle owners, TRYP employees, contractors, support personnel and other people reasonably affected by the TRYP platform.'],
  [4, 'Emergency services', 'When immediate emergency assistance is required, contact the appropriate Police, Ambulance, Fire and Rescue or other authorised emergency responder. TRYP may assist with relevant information where legally permitted or required, but does not guarantee that it can physically intervene.','critical'],
  [5, 'TRYP emergency button', 'Where implemented, the Passenger and/or Driver App may provide an emergency or SOS function that triggers an alert, shares relevant Trip or location information, contacts emergency services, contacts a designated emergency contact or contacts TRYP Safety. Functionality depends on the device, network, location and applicable law.','critical'],
  [6, 'Vehicle panic button', 'TRYP’s operating model must account for South African e-hailing requirements concerning panic buttons in e-hailing Vehicles. TRYP should support required Vehicle safety equipment and its integration into the wider emergency-response architecture. See the <a href="https://www.gov.za/news/media-statements/transport-gazettes-national-land-transport-amendment-act-and-regulations-e" target="_blank" rel="noreferrer">South African Government e-hailing framework ↗</a>.','critical'],
  [7, 'Emergency button design', 'The emergency function should be quick to activate and, where technically feasible, present clear choices: call emergency services, alert TRYP Safety, share location, contact an emergency contact, report unsafe driving and report an incident.','critical'],
  [8, 'Accident response', '<ol><li>Stop as safely as reasonably possible.</li><li>Assess whether anyone is injured.</li><li>Contact emergency services where necessary.</li><li>Use the TRYP emergency feature where available.</li><li>Notify TRYP.</li><li>Remain at the scene when legally required.</li><li>Cooperate with authorities and the applicable insurance process.</li></ol>','critical'],
  [9, 'Serious accidents', 'A serious accident may involve death, serious or multiple injuries, rollover, fire, a major collision, pedestrian involvement or dangerous road conditions. TRYP may immediately restrict the affected Driver Account as a temporary safety measure, not as an automatic finding of wrongdoing.','critical'],
  [10, 'Medical emergencies', 'Examples include unconsciousness, breathing difficulty, severe bleeding, seizure, suspected heart attack, severe allergic reaction or serious injury. The Driver should stop safely, contact medical assistance, use TRYP emergency functionality, provide reasonable assistance within their ability and follow emergency-professional instructions. Drivers are not expected to perform procedures for which they are not trained.','critical'],
  [11, 'Driver medical emergency', 'If a Driver becomes medically incapacitated, the Vehicle should be stopped as safely as possible, emergency help requested, Driver availability temporarily suspended and the Trip cancelled or transferred according to the circumstances.','critical'],
  [12, 'Unconscious person', 'If a person is unconscious, seek emergency assistance immediately. TRYP may provide relevant Trip information to responders where lawful and appropriate.','critical'],
  [13, 'Assault', 'If a Passenger or Driver is assaulted, move to safety if possible, contact emergency services where necessary, activate the TRYP emergency function, report the incident, preserve relevant evidence and cooperate with authorities.','critical'],
  [14, 'Sexual assault', 'TRYP treats sexual assault as an extremely serious safety matter. A report may result in immediate account restriction, preservation of records, safety escalation, contact with appropriate authorities where legally appropriate and permanent removal where supported by the investigation. TRYP will not require a victim to confront an alleged perpetrator.','critical'],
  [15, 'Sexual harassment', 'Unwanted sexual comments, propositions, touching, messages, requests for dates or sexual jokes may trigger immediate safety measures and account restrictions.','critical'],
  [16, 'Robbery', 'Prioritise personal safety and do not unnecessarily resist an armed or violent attacker. Once safe, contact emergency services, contact TRYP, report the incident and preserve evidence where possible.','critical'],
  [17, 'Hijacking', 'Personal safety comes first during a hijacking. Do not take unnecessary action that could escalate danger. Once safe, contact emergency authorities; TRYP may provide relevant information where legally permitted or required.','critical'],
  [18, 'Threats', 'Threats may involve physical violence, weapons, killing, property damage or sexual violence. Serious threats may trigger immediate account restrictions and safety escalation.','critical'],
  [19, 'Weapons', 'Do not attempt to confiscate a weapon, physically confront a person or escalate unnecessarily. Prioritise immediate safety and contact emergency authorities when appropriate.','critical'],
  [20, 'Dangerous driving', 'Report dangerous driving as soon as safely possible. Examples include excessive speeding, reckless overtaking, running red lights, aggressive weaving, apparent impairment, dangerous phone use and deliberate collisions.','high'],
  [21, 'Immediate danger', 'If a Passenger believes a Driver creates an immediate threat to life, use the emergency function where available, contact emergency services, request a safe stop where possible and leave the Vehicle when safe and lawful.','critical'],
  [22, 'Passenger threatening Driver', 'The Driver should avoid confrontation, stop somewhere safe when possible, contact emergency assistance if necessary and report the Passenger through TRYP.','critical'],
  [23, 'Passenger refuses to exit', 'The Driver should not use unnecessary force. Remain in a safe location, contact TRYP and contact authorities where necessary.','high'],
  [24, 'Driver refuses to end Trip', 'If a Passenger believes a Driver intentionally refuses to end the Trip, use the emergency function where available and seek emergency assistance if in immediate danger.','critical'],
  [25, 'Unauthorised route deviation', 'A significant unexplained route deviation may be a safety concern, but does not automatically indicate an emergency. Legitimate causes include closures, traffic, construction, navigation errors, Passenger requests and safety concerns.','high'],
  [26, 'Trip monitoring', 'TRYP may monitor location, Trip status, route, duration, pickup, drop-off, Driver and Vehicle information for safety and platform integrity, in accordance with privacy law and the TRYP Privacy Policy.'],
  [27, 'Automated safety detection', 'TRYP may identify risk signals such as extreme route deviation, unusually long stops, repeated emergency activations, unusual termination, device tampering or suspicious account behaviour. Automated detection is a risk signal, not automatic proof of wrongdoing.'],
  [28, 'False alarms', 'Emergency systems may be activated accidentally. Cancel the alert or inform TRYP as soon as safely possible. Genuine accidental activation will not automatically result in punishment.'],
  [29, 'Abuse of emergency systems', 'Repeated fake emergencies, deliberately harmful false reports, prank activations and manipulated emergency data may constitute a violation.','high'],
  [30, 'Good-faith reporting', 'TRYP distinguishes a deliberately false report from a genuine report made in good faith that cannot ultimately be substantiated. A person should not be punished merely because a genuine concern cannot be independently proven.'],
  [31, 'Missing Passenger', 'If a Passenger is believed missing or fails to arrive at an expected location, TRYP may review Trip information, contact the Driver or Passenger, escalate according to the circumstances and cooperate with authorities where legally required. TRYP is not a search-and-rescue organisation.','high'],
  [32, 'Driver fails to respond', 'If a Driver becomes unexpectedly unreachable during an active Trip, TRYP may attempt contact, contact the Passenger, review Trip data and escalate the matter according to risk.','high'],
  [33, 'Passenger fails to respond', 'If a Passenger cannot be contacted during an active Trip and circumstances appear unusual, TRYP may attempt reasonable safety checks and escalation.','high'],
  [34, 'Vehicle breakdown', 'Move to safety where possible, inform the Passenger, contact roadside assistance, notify TRYP and avoid leaving the Passenger in an unsafe location.','high'],
  [35, 'Fuel shortage', 'Running out of fuel is normally a Driver responsibility. If it creates an immediate safety risk, move people to safety and request appropriate assistance.'],
  [36, 'Fire', 'Stop where possible, turn off the engine, evacuate, move away, contact emergency services and do not return unnecessarily.','critical'],
  [37, 'Flooding', 'Do not knowingly drive through dangerous floodwater. Stop, find a safe alternative, follow official restrictions and notify the Passenger.','high'],
  [38, 'Severe weather', 'Drivers may modify or terminate a Trip when flooding, storms, hail, poor visibility or road conditions create a genuine safety risk.','high'],
  [39, 'Crime hotspots', 'TRYP may develop features identifying elevated-risk locations to warn users or suggest safer pickup points. Risk information must not be treated as proof that a person or area is criminal.'],
  [40, 'Safe pickup locations', 'Where possible, TRYP may recommend locations with lighting, visibility, safe stopping areas, reduced traffic risk and public access.'],
  [41, 'Driver identity display', 'TRYP should display sufficient Driver and Vehicle information for a Passenger to verify that the arriving Vehicle corresponds with the Trip. South Africa’s amended e-hailing framework addresses prescribed Driver and Vehicle information communicated electronically to Passengers; see the <a href="https://www.gov.za/sites/default/files/gcis_document/202406/50800nationallandtransportamendmentact232023.pdf" target="_blank" rel="noreferrer">National Land Transport Amendment Act reference ↗</a>.'],
  [42, 'Passenger verification', 'Passengers should verify Driver name, photograph, Vehicle registration, make/model and other information displayed by TRYP. Do not enter if the information does not reasonably match.'],
  [43, 'Driver verification of Passenger', 'Drivers should reasonably verify the Passenger before beginning a Trip without demanding unnecessary personal information.'],
  [44, 'Safety contacts', 'TRYP may allow users to nominate emergency contacts who may receive Trip status, Driver, Vehicle, pickup, destination or location information. Sharing depends on the feature and privacy requirements.'],
  [45, 'Location sharing', 'Where a user enables a safety feature requiring location sharing, TRYP may process location information to provide that feature under the Privacy Policy and applicable law.'],
  [46, 'Emergency data', 'Emergency records may include alert time, location, Trip ID, Driver, Passenger, Vehicle, alert type, relevant communications and resolution.'],
  [47, 'Evidence preservation', 'After a serious incident, TRYP may preserve Trip logs, GPS, App events, support conversations, communications, payment records, Account information and safety alerts.'],
  [48, 'Data preservation does not mean publication', 'Preserving evidence does not mean publicly disclosing it. Information is handled according to applicable law and the TRYP Privacy Policy.'],
  [49, 'Law enforcement', 'TRYP may provide information to law enforcement when required by law, valid legal process, an emergency where legally permitted or another lawful authority.'],
  [50, 'Emergency disclosure', 'For a genuine threat to life or serious physical safety, TRYP may disclose relevant information where permitted. Disclosures should be reasonably connected to the emergency.','critical'],
  [51, 'No guarantee of police response', 'TRYP cannot guarantee Police or Ambulance availability, response time, emergency outcomes or successful recovery of a person or Vehicle.'],
  [52, 'Network failure', 'Emergency functionality may be affected by poor coverage, Internet outages, device failure, depleted battery, GPS failure or software problems. Do not rely solely on the App in an emergency.','critical'],
  [53, 'Phone battery', 'Users remain responsible for sufficient device battery. TRYP cannot guarantee functionality when a device is off or has no battery.'],
  [54, 'GPS accuracy', 'GPS may be imprecise because of buildings, tunnels, weather, device limitations and network conditions. Location is an aid, not an exact guarantee.'],
  [55, 'Driver safety equipment', 'TRYP may establish Vehicle safety requirements including a panic button, fire extinguisher, first-aid equipment, reflective equipment and required markings where legally or operationally appropriate.'],
  [56, 'Vehicle markings', 'TRYP Vehicles must comply with regulatory e-hailing identification and marking requirements. The current South African framework addresses branding or an appropriate indication that a Vehicle is used for e-hailing.'],
  [57, 'Driver documentation', 'TRYP may require valid operating licences, professional driving permits, Vehicle documents, identity documents and other legally required credentials.'],
  [58, 'Driver screening', 'TRYP may conduct lawful Driver screening and verification. The applicable South African framework includes criminal vetting and other compliance requirements; requirements must be confirmed with transport counsel before launch. See the <a href="https://www.wcpp.gov.za/?q=node%2F20959" target="_blank" rel="noreferrer">Western Cape Provincial Parliament mobility reference ↗</a>.'],
  [59, 'Account suspension for safety', 'TRYP may temporarily suspend an Account where there is a credible safety concern, to prevent further incidents while information is reviewed.','high'],
  [60, 'Immediate suspension', 'TRYP may immediately restrict access where credible information suggests serious violence, sexual assault, hijacking, serious threats, dangerous driving, serious fraud or another major safety risk.','critical'],
  [61, 'Permanent removal', 'Following an appropriate review, TRYP may permanently remove a Driver or Passenger where serious misconduct is established or continued access presents an unacceptable safety or platform risk.'],
  [62, 'Safety review', 'A safety review may consider reports, Trip data, GPS, App logs, communications, photographs, videos, witnesses, relevant external information and responses from the parties.'],
  [63, 'Fairness', 'TRYP should not automatically assume the first reporter is correct. Where reasonably possible, both parties should provide relevant information, without preventing immediate protective action.'],
  [64, 'Protective action vs final finding', 'TRYP may temporarily restrict a user before a final determination when necessary to protect people. Protective action does not necessarily mean the allegation is true.'],
  [65, 'Driver appeals', 'Where an appeal mechanism applies, a Driver may challenge a safety-related decision and provide relevant evidence or explanation.'],
  [66, 'Passenger appeals', 'Passengers may challenge applicable account restrictions or safety decisions where TRYP provides an appeal mechanism.'],
  [67, 'Safety reporting', 'The App should provide accessible reporting categories for Accident, Assault, Threat, Dangerous driving, Harassment, Sexual misconduct, Robbery, Wrong Vehicle, Wrong Driver, route concerns, Fraud, Account security and Payment abuse.'],
  [68, 'Reporting priority', '<div class="priority-grid"><div><strong>Critical</strong><span>Immediate danger to life or serious injury.</span></div><div><strong>High</strong><span>Serious misconduct or credible safety threat.</span></div><div><strong>Normal</strong><span>Non-immediate safety concern.</span></div><div><strong>General</strong><span>Routine service or conduct issue.</span></div></div>','high'],
  [69, 'Safety support', 'TRYP may maintain a dedicated safety-support process for serious incidents, separate from ordinary customer support.'],
  [70, '24/7 response', 'If TRYP advertises a 24/7 emergency response service, it must maintain the staffing and infrastructure to support that promise. Until then, ordinary support must not be misrepresented as a 24/7 emergency response centre.'],
  [71, 'Third-party emergency providers', 'TRYP may integrate providers for emergency response, vehicle tracking, roadside assistance, security response, insurance or medical assistance. Availability and terms depend on the provider.'],
  [72, 'Insurance', 'TRYP may maintain or require insurance arrangements. Insurance does not replace emergency services, legal obligations or Driver and Passenger responsibilities.'],
  [73, 'Driver insurance', 'Drivers may be required to maintain insurance required by law or their TRYP agreement. TRYP may request proof.'],
  [74, 'Passenger property', 'Report lost or stolen property promptly. TRYP may assist in connecting parties but cannot guarantee recovery.'],
  [75, 'Personal security', 'Passengers and Drivers should verify Vehicle details, avoid displaying valuables, secure devices, use well-lit pickup locations and remain aware of surroundings.'],
  [76, 'Children and vulnerable persons', 'Additional care may be required for children, elderly people, people with disabilities and medically vulnerable people. TRYP may establish additional procedures.'],
  [77, 'Minors', 'TRYP may establish minimum ages for independent Passenger Accounts. Where minor transportation is permitted, additional requirements may apply.'],
  [78, 'Third-party bookings', 'Where one person books for another, the booking person may be responsible for accurate Passenger information and safety details requested by TRYP.'],
  [79, 'Emergency contacts and third-party bookings', 'A person booking for another Passenger should provide accurate information where TRYP requests it for safety purposes.'],
  [80, 'Driver family members', 'Drivers must not allow unauthorised family members or friends to access Passenger information.'],
  [81, 'Passenger family members', 'Passengers should not share another person’s private Trip information without appropriate authority.'],
  [82, 'Safety data access', 'Access to sensitive safety information should be restricted to authorised TRYP personnel or service providers who need it for legitimate purposes.'],
  [83, 'Employee confidentiality', 'TRYP personnel handling safety incidents must maintain confidentiality and comply with privacy requirements.'],
  [84, 'Security incidents', 'If TRYP systems are compromised, TRYP will follow its applicable security incident and data-breach procedures.'],
  [85, 'Cyberattacks during Trips', 'If an Account or device appears compromised, secure the Account, contact TRYP, avoid sharing authentication information and follow security instructions.'],
  [86, 'Account takeover', 'Report suspected compromise immediately. TRYP may lock the Account, reset credentials, verify identity, review suspicious activity and restore access where appropriate.'],
  [87, 'Phishing', 'TRYP will not intentionally request sensitive authentication information through unauthorised channels. Users should be cautious of messages claiming to be TRYP.'],
  [88, 'Emergency contact authority', 'An emergency contact does not automatically receive unrestricted Account access. Sharing remains subject to privacy requirements and the feature selected by the user.'],
  [89, 'Deceased users', 'When TRYP becomes aware of a death associated with a Trip, it may restrict Accounts, preserve information and cooperate with authorised authorities or representatives as legally appropriate.'],
  [90, 'Critical incident management', 'A critical incident may trigger an internal response team for safety assessment, Account restriction, evidence preservation, user communication, regulatory notification, law-enforcement cooperation and internal review.','critical'],
  [91, 'Regulatory cooperation', 'TRYP will seek to comply with applicable South African transport requirements. Section 66A of the National Land Transport Amendment Act addresses e-hailing applications, including fare estimates, final fares and Driver information. Review the <a href="https://www.gov.za/sites/default/files/gcis_document/202406/50800nationallandtransportamendmentact232023.pdf" target="_blank" rel="noreferrer">official Act ↗</a>.'],
  [92, 'Platform compliance', 'TRYP must not knowingly permit a Vehicle to provide e-hailing services where the required operating licence is invalid. The application must disconnect the Vehicle until valid documentation is obtained, subject to the final legal and operational implementation.','critical'],
  [93, 'Safety-first platform design', '<blockquote>The emergency button should never be buried behind five menus and a treasure map.</blockquote><p>Safety features should be visible, fast, simple, accessible, reliable and tested.</p>'],
  [94, 'Recommended Passenger safety screen', '<div class="safety-screen-card"><strong>🚨 Emergency</strong><span>Call Emergency Services</span><span>Share Trip</span><span>Alert Emergency Contact</span><span>Contact TRYP Safety</span><span>Report Dangerous Driving</span><span>Report Driver</span></div>'],
  [95, 'Recommended Driver safety screen', '<div class="safety-screen-card"><strong>🚨 Emergency</strong><span>Call Emergency Services</span><span>Alert TRYP Safety</span><span>Share Location</span><span>Contact Emergency Contact</span><span>Report Passenger</span><span>Vehicle Emergency</span></div>'],
  [96, 'Trip sharing', 'Where implemented, Passengers should be able to share Driver, Vehicle, pickup, destination, Trip status and live location with a trusted person.'],
  [97, 'Safety check-in', 'TRYP may introduce optional check-ins for longer or higher-risk Trips, such as “Are you okay?” with YES or I NEED HELP responses.'],
  [98, 'Automatic safety alerts', 'TRYP may introduce alerts based on predefined risk signals. Systems should be tested to minimise false positives, false negatives, unnecessary Police contact and privacy intrusion.'],
  [99, 'No false security promises', 'TRYP must not promise that a user is guaranteed to be safe. It should state that its safety features are designed to reduce risk and assist users during incidents.'],
  [100, 'Limitation of emergency response', 'TRYP is a technology platform. Emergency features depend on device availability, connectivity, GPS, third parties, emergency-service availability, user activation and correct information. TRYP cannot guarantee successful intervention.'],
  [101, 'Safety Policy does not limit legal rights', 'Nothing in this Policy excludes rights that cannot legally be excluded, prevents contacting emergency services, prevents reporting a crime or overrides applicable legislation.'],
  [102, 'Policy updates', 'TRYP may update this Policy to reflect new technology, safety features, threats, regulatory changes and lessons learned from incidents.'],
  [103, 'User acknowledgement', 'By using TRYP, users acknowledge that transportation involves inherent risks, reasonable precautions remain important, safety tools cannot eliminate all risks, emergency services should be contacted directly when immediate help is required and incidents should be reported promptly.'],
  [104, 'Final safety principle', '<div class="final-safety-principle"><strong>GET TO SAFETY FIRST.</strong><strong>CALL FOR HELP.</strong><strong>REPORT IT TO TRYP.</strong><strong>PRESERVE RELEVANT INFORMATION.</strong><span>The Trip can wait. A person’s safety cannot.</span></div>'],
];

const sections: SafetySection[] = rawSections.map(([number, title, body, priority]) => ({ number, title, body, priority }));
const sectionLink = (number: number) => `#safety-${number}`;
---
<SiteLayout title="Safety & Emergency Response Policy — TRYP" description="Read the TRYP Safety & Emergency Response Policy covering emergency buttons, accidents, incidents, trip monitoring, reporting and platform safety standards." path="/safety-policy/">
  <PageHero eyebrow="Safety · Operational policy" title={'Safety when<br /><em>it matters most.</em>'} description="The response framework TRYP is building for emergencies, serious incidents, safer trips and responsible platform operations." />
  <ContentLayout items={[
    { href: '#overview', label: 'Overview' },
    { href: '#safety-4', label: 'Immediate emergencies' },
    { href: '#safety-26', label: 'Trip monitoring' },
    { href: '#safety-41', label: 'Identity & data' },
    { href: '#safety-59', label: 'Protective action' },
    { href: '#safety-67', label: 'Reporting' },
    { href: '#safety-91', label: 'Compliance' },
    { href: '#safety-104', label: 'Final principle' },
  ]}>
    <div class="policy-draft-banner safety-draft-banner" role="note">
      <div class="policy-draft-icon" aria-hidden="true">!</div>
      <div><strong>Working operational policy · Legal and implementation review required</strong><p>This document is a structured TRYP draft. Confirm the operating entity, actual emergency capability, support staffing, panic-button integration, privacy controls, insurance arrangements and South African regulatory requirements before publication.</p></div>
    </div>
    <div class="safety-emergency-alert" role="alert"><strong>In immediate danger?</strong><span>Get to safety first, then contact the appropriate local emergency service. Do not rely solely on the TRYP App or public website for emergency assistance.</span><a href="/safety/">Read immediate safety guidance ↗</a></div>
    <div class="policy-meta" id="overview"><div><span>Company</span><strong>Hungry Development (Pty) Ltd / TRYP</strong></div><div><span>Effective date</span><strong>[INSERT DATE]</strong></div><div><span>Version · jurisdiction</span><strong>1.0 · Republic of South Africa</strong></div></div>
    <div class="safety-intro"><p class="lead">TRYP is designed to connect Passengers with Drivers. It is not a police, ambulance, security or emergency medical service.</p><p>This Policy explains the safety standards and response framework TRYP intends to use for accidents, medical emergencies, assault, robbery, hijacking, threats, sexual misconduct, missing or stranded people, Driver emergencies, breakdowns, dangerous driving, suspicious activity and other serious incidents.</p></div>
    <nav class="safety-action-grid" aria-label="Emergency action priorities"><a href="#safety-4"><span>01</span><strong>Immediate danger</strong><small>Contact emergency services first.</small></a><a href="#safety-5"><span>02</span><strong>Use SOS</strong><small>Alert help and share relevant Trip information.</small></a><a href="#safety-47"><span>03</span><strong>Preserve information</strong><small>Keep records, messages and incident details.</small></a><a href="#safety-67"><span>04</span><strong>Report to TRYP</strong><small>Use the right safety reporting path.</small></a></nav>
    <nav class="terms-section-nav safety-section-nav" aria-label="Safety policy sections"><strong>Jump to a section</strong><div><a href={sectionLink(1)}>1–25 · Emergency response</a><a href={sectionLink(26)}>26–40 · Monitoring & conditions</a><a href={sectionLink(41)}>41–58 · Identity, data & Vehicles</a><a href={sectionLink(59)}>59–70 · Reviews & support</a><a href={sectionLink(71)}>71–90 · People, privacy & security</a><a href={sectionLink(91)}>91–104 · Compliance & design</a></div></nav>
    <div class="safety-sections">{sections.map((section) => <section class:list={['policy-section', `safety-priority-${section.priority ?? 'standard'}`, { 'safety-final-section': section.number === 104 }]} id={`safety-${section.number}`}><h2>{section.number}. {section.title}</h2><div set:html={section.body}></div>{section.number === 6 && <p class="safety-source-note">Regulatory reference: <a href="https://www.gov.za/news/media-statements/transport-gazettes-national-land-transport-amendment-act-and-regulations-e" target="_blank" rel="noreferrer">South African Government transport framework ↗</a></p>}{section.number === 63 && <div class="safety-callout"><strong>Protective action is not a final finding.</strong><p>TRYP may act quickly to protect people while still giving the parties a fair opportunity to provide relevant information.</p></div>}</section>)}</div>
    <div class="safety-implementation-note"><strong>Connect this Policy to the product before launch</strong><p>The emergency flow should be visible in both Apps, tested on supported devices, connected to real support and escalation procedures, and reviewed against the Driver Code, Driver Terms, Privacy Policy, insurance process and applicable South African law.</p><div class="actions"><a class="button button-red" href="/safety/">Read public safety guidance <span>→</span></a><a class="button button-outline" href="/driver-code/">Read Driver Code <span>↗</span></a><a class="button button-outline" href="/driver-agreement/">Read Driver Agreement <span>↗</span></a><a class="button button-outline" href="mailto:legal@tryp.co.za">Contact legal <span>↗</span></a></div></div>
  </ContentLayout>
</SiteLayout>
