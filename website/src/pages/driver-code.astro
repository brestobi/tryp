---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';

interface CodeSection { number: number; title: string; body: string; level?: string; }
const rawSections: [number, string, string, string?][] = [
[1,'Purpose','The TRYP Driver Code of Conduct ("Code") establishes the standards expected from every Driver using the TRYP platform. It protects Passengers and Drivers, promotes road safety, maintains professional standards, prevents harassment, discrimination and fraud, protects personal information and provides a fair framework for handling violations. It applies while a Driver is online, accepting or completing Trips, communicating through TRYP, handling Passenger property or using Passenger information. Confidentiality and data obligations continue after a Driver stops using TRYP.'],
[2,'Our core principles','Every Driver is expected to follow five principles: <strong>Safety</strong> — get the Passenger there safely; <strong>Respect</strong> — treat people with dignity; <strong>Honesty</strong> — do not manipulate Trips, fares, ratings, Documents, Accounts or payments; <strong>Professionalism</strong> — represent TRYP responsibly; and <strong>Accountability</strong> — take responsibility and cooperate with legitimate investigations.'],
[3,'The golden rule','Never deliberately do something to a Passenger that you would reasonably object to happening to yourself or your family. This includes threatening, intimidating, following, harassing, touching without consent, stealing, manipulating fares, exposing private information or driving dangerously.'],
[4,'Safety comes first','Always prioritise safety over Earnings, Trip completion, ratings, Passenger demands, time targets, bonuses or acceptance rates. A Driver may refuse or terminate a Trip where continuing creates a genuine safety risk, provided the Driver acts reasonably and lawfully.'],
[5,'Professional Driver behaviour','Be reasonably polite, communicate clearly, avoid unnecessary arguments, respect privacy, drive responsibly, keep the Vehicle clean, follow lawful instructions and use reasonable judgement. Do not deliberately create an intimidating environment.'],
[6,'Zero-tolerance conduct','Physical or sexual assault, kidnapping, unlawful confinement, robbery, serious threats, dangerous or impaired driving, deliberate fraud, identity theft, serious privacy violations, GPS manipulation, account selling or renting, and deliberate Platform hacking are serious violations. They may result in immediate suspension and permanent removal.','critical'],
[7,'Driver identity','The Driver must always be the person registered to the Driver Account. Friends, family, employees, other Drivers and unregistered persons may not operate under the Account.'],
[8,'No Account renting','Do not rent, sell or lease a TRYP Account, including arrangements such as “use my Driver Account while I am away”. Account sharing is prohibited.','serious'],
[9,'Driver verification','Complete required identity verification personally. Do not use another identity, submit false, modified or expired Documents, defeat facial verification or use another person’s photograph.','serious'],
[10,'Vehicle identity','The Vehicle used for Trips must match the Vehicle registered on the Driver Account. Do not secretly substitute another Vehicle. Passengers must be able to verify Driver and Vehicle information shown by the Platform.'],
[11,'Operating licence','Maintain every licence or permit required by law. Do not provide the affected service when a required operating licence is invalid. TRYP may deactivate the Driver or Vehicle until valid documentation is supplied. The amended South African e-hailing framework commenced on 12 September 2025 and is available through the <a href="https://www.gov.za/news/media-statements/transport-gazettes-national-land-transport-amendment-act-and-regulations-e" target="_blank" rel="noreferrer">South African Government ↗</a>.','serious'],
[12,'Vehicle roadworthiness','Never knowingly operate a dangerous or unroadworthy Vehicle. Before going online, reasonably check tyres, brakes, lights, indicators, seatbelts, doors, mirrors, windscreen, fuel and general mechanical condition.'],
[13,'Vehicle cleanliness','Keep the Passenger area reasonably clean and suitable for transportation. Remove excessive rubbish, food waste, strong odours, dangerous objects and excessive clutter.'],
[14,'Smoking','Do not smoke in a manner prohibited by law or TRYP policy. Avoid leaving the Vehicle with an excessive smoke odour.'],
[15,'Alcohol and drugs','Never drive for TRYP while impaired by alcohol, illegal drugs, misused medication or another substance. If you are not fit to drive, go offline.','critical'],
[16,'Fatigue','Do not continue driving when too tired to drive safely. No bonus or Trip target overrides the responsibility to rest and drive safely.'],
[17,'Speed','Obey applicable speed limits and road and weather conditions. Aggressive driving to complete more Trips is prohibited.'],
[18,'Reckless driving','Do not race, tailgate, weave aggressively, drive unlawfully on pavements, ignore signals, perform dangerous manoeuvres or intentionally intimidate road users.','serious'],
[19,'Mobile phones','Comply with South African laws concerning mobile-phone use while driving. Configure the Driver App before driving and do not interact with the phone in a way that creates a hazard.'],
[20,'Navigation','Use navigation responsibly. You remain responsible for safe driving even when navigation is wrong. A reasonable alternative route may be used for traffic, closures, safety, construction, weather, Passenger request or navigation error.'],
[21,'Route manipulation','Never take unnecessarily long routes solely to increase a Fare. Do not drive in circles, pass the destination and return, take unnecessary detours or keep a Trip active after arrival.','serious'],
[22,'GPS spoofing','Do not use fake GPS applications, location spoofing, emulator manipulation, device-based manipulation or software designed to falsify Driver location.','serious'],
[23,'Fake Trips','Do not self-book, ask friends to create fake Trips, create Trips without carrying a Passenger, end fake Trips or artificially generate kilometres.','serious'],
[24,'Trip manipulation','Do not manipulate pickup, destination, duration, distance, status, Fare or cancellation information.','serious'],
[25,'Accepting Trips','Accept or decline Trips using available TRYP functionality. Once accepted, make reasonable efforts to complete the Trip unless a legitimate reason prevents completion.'],
[26,'Cancellations','Cancel only where reasonably necessary, including an unlocatable Passenger, unsafe pickup, Vehicle problem, emergency, Passenger behaviour, unlawful request, capacity issue or genuine safety concern.'],
[27,'Abusive cancellation','Do not cancel for unlawful discriminatory reasons or manipulate cancellation systems to avoid areas, increase incentives, avoid specific Passengers or alter statistics.','moderate'],
[28,'Passenger pickup','Park safely, avoid dangerous locations, reasonably confirm the Passenger, ensure Vehicle details match the App and allow safe entry.'],
[29,'Passenger verification','Reasonably verify that the person entering is associated with the Trip. Do not demand excessive personal information.'],
[30,'Passenger privacy','Passenger information may include name, photograph, phone number, pickup, destination, Trip history and payment information. Use it only for legitimate TRYP purposes.','serious'],
[31,'No stalking','Never follow a Passenger, visit their home after a Trip, wait outside their workplace, track movements or repeatedly contact them.','critical'],
[32,'No personal solicitation','Do not build a private customer list or pressure Passengers for personal numbers, social-media accounts, email addresses or home information.','serious'],
[33,'Off-platform solicitation','Do not move TRYP Passengers off-platform for personal gain. “Cancel and I will take you privately”, “save my number” and “I will give you a cheaper price” are prohibited.','serious'],
[34,'Fares','Accept the Fare calculated or displayed by the applicable TRYP system. Do not invent additional charges.'],
[35,'Cash','Where cash is supported, collect only the applicable amount, provide reasonable change where possible, record the Trip correctly and report payment problems honestly.'],
[36,'No double charging','Never knowingly collect both the full cash Fare and the same Fare electronically. Follow the payment-dispute process when a problem occurs.','serious'],
[37,'Tolls','Handle tolls according to TRYP fare rules. Never invent toll charges.'],
[38,'Payment fraud','Do not claim payment was not received, create fake payment records, manipulate cash Trips, collude, use stolen payment information or create artificial transactions.','serious'],
[39,'Ratings','Do not pressure Passengers for positive ratings, threaten them over ratings or offer money or benefits for ratings.'],
[40,'Rating retaliation','A low rating is not permission to threaten, contact, follow, harass or falsely report a Passenger.','serious'],
[41,'Discrimination','Do not unlawfully discriminate or refuse service because of protected characteristics. Treat every Passenger fairly.','serious'],
[42,'Respectful communication','Do not use racial slurs, sexual insults, threats, hate speech, degrading language or intimidation.','serious'],
[43,'Sexual conduct','Zero tolerance applies to unwanted sexual comments, intrusive questions, propositions, sexual touching, exposure, requests for sexual acts, sexual messages, sexual photographs or sexual use of Passenger information.','critical'],
[44,'Physical contact','Avoid unnecessary physical contact. Sexual, threatening or aggressive contact is prohibited.','critical'],
[45,'Threats','Never threaten violence, property damage, exposure of private information, false reporting or physical retaliation.','critical'],
[46,'Conflicts with Passengers','Remain calm, avoid escalation, stop somewhere safe if necessary, contact support and end the Trip safely if continuation is unreasonable. Never turn an ordinary disagreement into a physical confrontation.'],
[47,'Passenger intoxication','Intoxication is not automatically a reason for refusal. Refuse or end a Trip only where the Passenger creates a genuine safety risk and law and TRYP policy permit it.'],
[48,'Passenger aggression','If a Passenger becomes violent or presents an immediate threat, move to safety, end the Trip safely, use emergency functionality and contact emergency services where necessary.','critical'],
[49,'Weapons','Comply with applicable weapons law. Do not facilitate unlawful transportation and do not physically confront a suspected Passenger beyond what is necessary for immediate safety.'],
[50,'Illegal goods','Do not knowingly transport illegal goods. Where suspicious circumstances create a serious safety concern, prioritise safety and contact appropriate authorities where appropriate.'],
[51,'Service animals','Comply with legal requirements for recognised service animals. Do not falsely classify a legitimate service animal as an ordinary pet to avoid carrying it.'],
[52,'Pets','Apply reasonable TRYP rules for ordinary pets and ride categories. Refusal must not be used to discriminate against a service animal.'],
[53,'Children','Comply with laws concerning children. Do not knowingly transport children unlawfully or unsafely, and do not exploit or solicit children.'],
[54,'Child safety','Never make sexual comments to children, photograph them for personal reasons, contact them outside legitimate Trip purposes, offer unrelated services or establish inappropriate relationships.','critical'],
[55,'Lost property','Report property left in the Vehicle through TRYP. Do not keep, sell, use, destroy, hide it or demand unreasonable payment for return.'],
[56,'Returning property','Cooperate reasonably with the lost-property process and reasonable arrangements for return.'],
[57,'Accidents','Prioritise safety, stop safely, check injuries, contact emergency services, provide reasonable assistance, notify TRYP and cooperate with investigations.'],
[58,'Emergencies','Use available safety tools when necessary. If TRYP provides an emergency or panic feature, use it responsibly. The South African framework also addresses panic-button safety measures in e-hailing vehicles. See the future <a href="/safety-policy/">Safety & Emergency Response Policy</a> for the operational escalation process.','serious'],
[59,'False emergency reports','Do not deliberately abuse emergency functionality. Good-faith use is protected even if the event later proves not to require emergency intervention.'],
[60,'Dashcam and recording','Comply with privacy and data-protection law when using cameras. Do not post, sell, unnecessarily share or use recordings to harass Passengers.','serious'],
[61,'Social media','Never publish Passenger images, videos, names, addresses, destinations, phone numbers or personal information without lawful authority or permission.','serious'],
[62,'Confidentiality','Keep information obtained through TRYP confidential. This obligation survives termination of the Driver Account.'],
[63,'POPIA','Handle Passenger information responsibly. POPIA governs lawful processing and protection of personal information. Review the <a href="https://inforegulator.org.za/about/" target="_blank" rel="noreferrer">Information Regulator guidance ↗</a>, the <a href="https://eservices.inforegulator.org.za/default.aspx" target="_blank" rel="noreferrer">Information Regulator eServices portal ↗</a> and the final Driver Privacy Notice.','serious'],
[64,'Driver data','TRYP may process Driver information for identity verification, payments, safety, compliance, fraud prevention, platform operation and regulatory requirements. The applicable Privacy Policy explains processing.'],
[65,'Cybersecurity','Do not hack TRYP, steal credentials, abuse APIs, introduce malware, scrape without authority, reverse engineer for malicious purposes or bypass security controls.','critical'],
[66,'Bots','Do not use automation to accept or reject Trips, manipulate incentives or demand, or generate fake activity.','serious'],
[67,'Multiple Accounts','Do not create multiple identities to evade suspension, manipulate incentives, circumvent verification, manipulate ratings or generate fraud.','serious'],
[68,'Collusion','Do not coordinate with Passengers or Drivers to create fake Trips, ratings, referrals, cancellations, artificial demand or fraudulent promotions.','serious'],
[69,'Referral fraud','Use referral programs honestly. Do not refer yourself or create fake Passenger or Driver Accounts.'],
[70,'Promotion abuse','Promotions reward legitimate activity, not artificial activity. Do not manipulate bonuses or incentives.'],
[71,'Driver-Passenger relationships','Respect the professional boundary. Never pressure a Passenger into dating, friendship, sexual activity, personal meetings or unrelated business.','serious'],
[72,'Passenger consent','Using TRYP does not consent to touching, sexual comments, personal photography, personal recording, contact, dating or sexual activity.','critical'],
[73,'No retaliation','Do not retaliate against a Passenger who complains, reports misconduct, gives a low rating, refuses personal contact, requests another route or uses safety functionality.','serious'],
[74,'Driver responsibility for Vehicle','Keep fuel, tyres, brakes, lights, seatbelts, roadworthiness and Documents ready for every Trip.'],
[75,'Vehicle modifications','Do not make modifications that make the Vehicle unsafe or non-compliant.'],
[76,'Passenger seatbelts','Give Passengers the opportunity to use available seatbelts and comply with road-traffic laws.'],
[77,'Overloading','Never carry more Passengers than the legally permitted capacity.'],
[78,'Boot/loading area','Never transport a Passenger in a boot, luggage compartment or area not legally designed for Passengers.','critical'],
[79,'Dangerous items in Vehicle','Do not keep dangerous objects where they could injure Passengers.'],
[80,'Vehicle security','Take reasonable steps to secure the Vehicle, Passenger belongings, Driver device and TRYP information.'],
[81,'Cash security','Take reasonable precautions when carrying cash and do not expose unnecessary amounts.'],
[82,'Unsafe pickup locations','Decline or modify pickup when stopping creates a genuine safety or legal problem, such as active lanes, dangerous intersections, prohibited stopping or immediate crime threats.'],
[83,'Unsafe destinations','If a destination creates an immediate safety concern, contact support or use safety procedures rather than escalating directly with the Passenger.'],
[84,'Route privacy','Do not reveal or exploit information about a Passenger’s destination.'],
[85,'Personal information after the Trip','Once the Trip ends, do not retain or use Passenger information for unrelated purposes.','serious'],
[86,'Passenger contact after Trip','Contact after a Trip is limited to legitimate reasons such as lost property, a Trip dispute, a safety matter or TRYP-authorised communication.'],
[87,'Driver-Passenger communication','Use TRYP communications responsibly. Messages must not contain threats, sexual content, hate speech, unwanted solicitation, harassment or fraudulent requests.'],
[88,'Recording communications','Comply with applicable laws when recording calls or communications.'],
[89,'Law enforcement requests','Comply with lawful requests from authorised authorities. TRYP may cooperate with lawful investigations.'],
[90,'Criminal conduct','Nothing prevents TRYP from reporting suspected criminal conduct where appropriate or legally required.'],
[91,'Driver complaints','Drivers may report Passenger misconduct, safety concerns, fraud, payment problems, Vehicle problems, harassment and Platform problems. Genuine good-faith complaints are protected.'],
[92,'Passenger complaints','Passengers may report Driver misconduct. A complaint does not automatically mean guilt; TRYP may assess evidence.'],
[93,'Fair investigation','Where reasonably possible, TRYP may receive a complaint, assess seriousness, apply safety measures, review evidence, request information, invite a response and decide.'],
[94,'Temporary suspension','A Driver may be suspended during a serious investigation. Suspension is a safety or investigative measure and does not necessarily prove the allegation.'],
[95,'Driver appeal','Where available, provide an explanation, Trip information, evidence and witness information through the appeal process.'],
[96,'Evidence TRYP may consider','TRYP may consider GPS, Trip and App records, payments, communications, reports, ratings, photographs, videos, Vehicle information and device/security information lawfully obtained.'],
[97,'Evidence is not automatic guilt','Distinguish between an allegation, evidence and a finding. A complaint should not automatically be treated as proof.'],
[98,'Severity levels','TRYP may classify violations as Level 1 Minor, Level 2 Moderate, Level 3 Serious or Level 4 Critical. Classification considers safety, integrity, intent, evidence and history.'],
[99,'Examples of Level 1 violations','Poor cleanliness, minor communication problems, non-critical procedure failures or failure to update non-critical information may result in a warning, education, reminder or temporary restriction.','minor'],
[100,'Examples of Level 2 violations','Repeated cancellation abuse, fare disputes, repeated poor conduct, unauthorised solicitation, repeated Vehicle-standard failures or rating manipulation may result in warnings, training, suspension, adjustments or review.','moderate'],
[101,'Examples of Level 3 violations','Fraud, GPS manipulation, fake Trips, Account sharing, serious harassment, deliberate Fare manipulation, repeated safety violations or Passenger-data misuse may result in immediate suspension, investigation, removal or referral.','serious'],
[102,'Examples of Level 4 violations','Sexual assault, serious physical assault, kidnapping, serious threats, robbery, dangerous driving causing serious harm, deliberate identity fraud, major payment fraud, cyberattack or deliberate Passenger exploitation may result in immediate suspension and permanent termination.','critical'],
[103,'Consequences are not automatic','TRYP may consider severity, evidence, history, intent, safety, frequency and whether conduct was deliberate. A different response may apply where circumstances justify it.'],
[104,'Repeat offenders','Repeated violations may result in progressively stronger action. Repeated minor violations may eventually lead to suspension or termination.'],
[105,'Serious violations may skip warnings','TRYP does not need to issue three warnings before acting. A critical safety violation may justify immediate action.','serious'],
[106,'Good-faith errors','Not every mistake is misconduct. TRYP may distinguish honest mistakes, negligence, recklessness, deliberate misconduct and fraud.'],
[107,'Cooperation','Cooperate reasonably with legitimate investigations by providing Trip information, explanations, Documents, Vehicle information and relevant evidence.'],
[108,'False information during investigations','Knowingly providing false information to investigators may constitute a separate violation.','serious'],
[109,'Deleting evidence','Do not deliberately destroy or manipulate relevant evidence after learning of a legitimate investigation.','serious'],
[110,'Privacy during investigations','TRYP should limit investigation access to information reasonably necessary for the matter, subject to legal and safety requirements.'],
[111,'Protection against retaliation','TRYP prohibits retaliation against Passengers, Drivers, employees, contractors or other people making genuine reports or participating in investigations.'],
[112,'False reporting','Deliberately fabricated complaints may constitute misconduct. Honest complaints that are not proven are not automatically false.'],
[113,'Driver safety','Drivers may also be victims of robbery, assault, harassment, fraud and violence. Report incidents through TRYP safety systems.'],
[114,'Passenger safety','Drivers contribute to a safe environment but are not security officers, police or medical professionals. Act reasonably and safely during emergencies.'],
[115,'No vigilante action','Do not take unnecessary physical action against Passengers or suspected criminals. Contact emergency services or law enforcement where appropriate.'],
[116,'Emergency location','Where supported, TRYP safety systems may use available Trip/location information to assist an incident response.'],
[117,'Driver training','TRYP may require training on safety, Platform use, conduct, anti-discrimination, privacy, fraud, emergency procedures and Vehicle standards.'],
[118,'Training compliance','Training may be required before activating a category, returning from suspension, continuing a service or meeting new regulatory requirements.'],
[119,'Accessibility','Reasonably accommodate Passengers with disabilities in accordance with law and TRYP policy. Do not use disability as an excuse for discrimination.'],
[120,'Professional appearance','Maintain a clean and professional appearance suitable for Passenger transportation.'],
[121,'Uniform','If TRYP introduces an official uniform, comply with applicable uniform requirements.'],
[122,'TRYP brand','Do not use TRYP branding to imply personal ownership, employment where none exists, official government status or authority beyond your actual role.'],
[123,'Unauthorised advertising','Do not place unauthorised advertising, stickers or commercial material on or inside the Vehicle in a way that misrepresents TRYP, harms safety, violates law or interferes with identification.'],
[124,'Driver feedback','Provide constructive feedback about App functionality, safety, Passenger conduct, Vehicle standards, payments and support.'],
[125,'Platform abuse','Do not overload support with false complaints, duplicate requests, threats, abusive messages or fraudulent claims.'],
[126,'Support staff','Treat TRYP support staff respectfully. Abuse or threats toward support staff may result in action.'],
[127,'No bribery','Do not offer or request bribes involving TRYP employees, support, Drivers, Passengers, inspectors or authorities.'],
[128,'Conflict of interest','Disclose relevant conflicts where TRYP reasonably requires disclosure.'],
[129,'Outside business','Lawful outside business is allowed unless restricted, but do not use Passenger information from TRYP to build an unrelated customer base.'],
[130,'Driver responsibility','Being a TRYP Driver means accepting responsibility for your conduct, Vehicle, driving, Account, Documents, treatment of Passengers and use of Passenger information.'],
[131,'Three simple rules','<div class="code-rule-card"><strong>RULE 1: DRIVE SAFELY.</strong><strong>RULE 2: TREAT PEOPLE WITH RESPECT.</strong><strong>RULE 3: DON’T CHEAT THE PLATFORM OR THE PASSENGER.</strong></div>'],
[132,'Serious breach','Access may be suspended or terminated for conduct materially threatening Passenger, Driver or public safety, TRYP security or financial integrity, regulatory compliance or privacy.','serious'],
[133,'Relationship with Driver Terms','This Code forms part of the <a href="/driver-terms/">TRYP Driver Terms & Conditions</a> and should be read with the <a href="/driver-agreement/">TRYP Driver Agreement</a>. If there is a conflict, applicable law and mandatory regulation take priority, then the Driver Agreement, Driver Terms, then this Code as an operational standard.'],
[134,'Changes to this Code','TRYP may update the Code to improve safety, address fraud, comply with law, improve service or address emerging risks. Material changes may be communicated through the Driver App or another appropriate channel.'],
[135,'Driver acknowledgement','By activating Driver Mode, accepting Trips or continuing to use TRYP, the Driver confirms they have read and understand this Code, agree to follow it, understand possible warnings, restrictions, suspension or termination, and understand that serious misconduct may result in immediate action.'],
];
const sections: CodeSection[] = rawSections.map(([number,title,body,level]) => ({ number, title, body, level }));
const sectionLink = (number: number) => `#code-${number}`;
---
<SiteLayout title="Driver Code of Conduct — TRYP" description="Read the TRYP Driver Code of Conduct covering safety, professionalism, Passenger privacy, fraud prevention and enforcement standards." path="/driver-code/">
  <PageHero eyebrow="Driver app · Standards" title={'The code for<br /><em>driving right.</em>'} description="A practical rulebook for safe, respectful, honest and accountable driving on the TRYP platform." />
  <ContentLayout items={[
    { href: '#overview', label: 'Overview' },
    { href: '#code-1', label: 'Purpose & principles' },
    { href: '#code-10', label: 'Vehicle & licences' },
    { href: '#code-20', label: 'Driving safety' },
    { href: '#code-30', label: 'Passenger privacy' },
    { href: '#code-98', label: 'Severity levels' },
    { href: '#code-135', label: 'Acknowledgement' },
  ]}>
    <div class="policy-draft-banner code-draft-banner" role="note">
      <div class="policy-draft-icon" aria-hidden="true">✓</div>
      <div><strong>Operational standard · Legal and policy review required</strong><p>This Code is a working TRYP platform policy, not legal advice. Confirm it against the Driver Terms, Safety & Emergency Policy, Driver Privacy Notice, enforcement process and current South African transport requirements before launch.</p></div>
    </div>
    <div class="policy-meta" id="overview"><div><span>Effective date</span><strong>[INSERT DATE]</strong></div><div><span>Last updated</span><strong>[INSERT DATE]</strong></div><div><span>Version</span><strong>1.0</strong></div></div>
    <div class="code-intro"><p class="lead">Safety, respect, honesty, professionalism and accountability are the standard for every TRYP Driver.</p><p>This Code applies whenever a Driver is online, accepting requests, travelling to a Passenger, transporting a Passenger, completing a Trip, communicating through TRYP, handling Passenger property or using Passenger information obtained through TRYP.</p></div>
    <nav class="code-principles" aria-label="Code principles"><a href="#code-4"><span>01</span><strong>Safety first</strong><small>No Trip is more important than human life.</small></a><a href="#code-5"><span>02</span><strong>Respect people</strong><small>Treat Passengers and road users with dignity.</small></a><a href="#code-21"><span>03</span><strong>Drive responsibly</strong><small>Follow the law and road conditions.</small></a><a href="#code-98"><span>04</span><strong>Be accountable</strong><small>Fair review for every violation.</small></a></nav>
    <nav class="terms-section-nav code-section-nav" aria-label="Code sections"><strong>Jump to a section</strong><div><a href={sectionLink(1)}>1–9 · Purpose & identity</a><a href={sectionLink(10)}>10–24 · Vehicle & driving</a><a href={sectionLink(25)}>25–40 · Trips & money</a><a href={sectionLink(41)}>41–64 · Respect & privacy</a><a href={sectionLink(65)}>65–80 · Platform & Vehicle</a><a href={sectionLink(81)}>81–97 · Incidents & investigations</a><a href={sectionLink(98)}>98–112 · Enforcement</a><a href={sectionLink(113)}>113–135 · Training & acknowledgement</a></div></nav>
    <div class="code-sections">{sections.map((section) => <section class:list={['policy-section', `code-level-${section.level ?? 'standard'}`, { 'code-final-section': section.number === 135 }]} id={`code-${section.number}`}><h2>{section.number}. {section.title}</h2><div set:html={section.body}></div>{section.number === 11 && <p class="code-source-note">Reference: <a href="https://www.gov.za/news/media-statements/transport-gazettes-national-land-transport-amendment-act-and-regulations-e" target="_blank" rel="noreferrer">South African Government e-hailing framework ↗</a></p>}{section.number === 63 && <p class="code-source-note">Reference: <a href="https://inforegulator.org.za/about/" target="_blank" rel="noreferrer">Information Regulator ↗</a></p>}{section.number === 98 && <div class="severity-grid"><div><strong>Level 1 · Minor</strong><span>Warning, education or reminder.</span></div><div><strong>Level 2 · Moderate</strong><span>Training, restriction or account review.</span></div><div><strong>Level 3 · Serious</strong><span>Immediate suspension, investigation or removal.</span></div><div><strong>Level 4 · Critical</strong><span>Immediate suspension and possible permanent termination.</span></div></div>}</section>)}</div>
    <div class="code-quick-reference"><span class="code-label">Quick reference</span><h2>What TRYP expects</h2><div class="quick-table"><div><strong>Safe driving</strong><span class="good">Required</span></div><div><strong>Valid Documents & correct Vehicle</strong><span class="good">Required</span></div><div><strong>Account sharing · Fake GPS · Fake Trips</strong><span class="bad">Prohibited</span></div><div><strong>Fare manipulation · Off-platform solicitation</strong><span class="bad">Prohibited</span></div><div><strong>Sexual harassment · Assault · Stalking</strong><span class="critical">Zero tolerance</span></div><div><strong>Genuine safety report · Lost-property reporting</strong><span class="good">Protected / required</span></div><div><strong>Respectful treatment · Investigation cooperation</strong><span class="good">Required</span></div></div></div>
    <div class="code-implementation-note" id="safety-policy"><strong>Implementation note</strong><p>This Code should be tied to the Driver App’s onboarding, safety, suspension and appeal flows. TRYP should also maintain a separate Safety & Emergency Response Policy covering SOS, accidents, robbery, assault, medical emergencies, evidence preservation, law-enforcement requests and post-incident support.</p><div class="actions"><a class="button button-red" href="/driver-terms/">Read Driver Terms <span>→</span></a><a class="button button-outline" href="/safety-policy/">Read Safety Policy <span>↗</span></a><a class="button button-outline" href="/driver-agreement/">Read Driver Agreement <span>↗</span></a><a class="button button-outline" href="/drive/">Return to driver page <span>↗</span></a></div></div>
  </ContentLayout>
</SiteLayout>
