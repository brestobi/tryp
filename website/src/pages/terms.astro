---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';

interface TermSection {
  number: number;
  title: string;
  body: string;
}

const terms: TermSection[] = [
  { number: 1, title: 'About these Terms', body: `<p>These Passenger Terms & Conditions ("Terms") govern your access to and use of the TRYP passenger application, website, platform and related services.</p><p>These Terms form a legally binding agreement between you ("Passenger", "you" or "your") and:</p><div class="terms-entity-card"><div><span>Legal entity</span><strong>[INSERT FULL LEGAL COMPANY NAME]</strong></div><div><span>Trading name</span><strong>TRYP</strong></div><div><span>Registration number</span><strong>[INSERT]</strong></div><div><span>Registered address</span><strong>[INSERT]</strong></div><div><span>Email</span><strong>[INSERT]</strong></div></div><p>TRYP provides technology and related services that facilitate the connection between passengers and drivers offering transportation services. The actual transportation of a passenger is performed by the driver using the vehicle associated with the driver's TRYP account and operating under applicable legal and regulatory requirements.</p><p>Nothing in these Terms is intended to unlawfully exclude or limit any right you have under South African law.</p>` },
  { number: 2, title: 'Definitions', body: `<p>For purposes of these Terms:</p><div class="terms-definition-grid"><div><strong>App</strong><span>The TRYP mobile application.</span></div><div><strong>Account</strong><span>Your registered TRYP passenger account.</span></div><div><strong>Driver</strong><span>A person approved by TRYP to provide transportation services through the platform.</span></div><div><strong>Fare</strong><span>The amount payable for a Trip.</span></div><div><strong>Passenger</strong><span>The person using a TRYP passenger account.</span></div><div><strong>Platform</strong><span>The technology, software, applications, websites, systems and services operated or made available by TRYP.</span></div><div><strong>Services</strong><span>The services made available through TRYP.</span></div><div><strong>Trip</strong><span>A transportation journey requested through TRYP.</span></div><div><strong>Vehicle</strong><span>The motor vehicle associated with an approved Driver and used to provide a Trip.</span></div><div><strong>TRYP</strong><span>“TRYP”, “we”, “us” or “our” means [LEGAL ENTITY].</span></div></div>` },
  { number: 3, title: 'Acceptance of these Terms', body: `<p>By using TRYP, you confirm that you have read and understand these Terms, agree to comply with them, are legally capable of entering into the agreement, have provided accurate information, and will use TRYP only for lawful purposes.</p><p>Where you use TRYP on behalf of another person or organisation, you confirm that you have authority to do so.</p>` },
  { number: 4, title: 'Electronic acceptance', body: `<p>Your acceptance electronically, including by selecting “I Agree”, creating an account, selecting a checkbox, requesting a ride, or continuing to use TRYP after being presented with these Terms, may constitute electronic acceptance to the extent permitted by applicable law.</p><p>Electronic agreements and data messages are recognised under South Africa’s Electronic Communications and Transactions Act. TRYP may retain records of your acceptance for evidentiary and administrative purposes. The responsible legal owner should confirm the final electronic-acceptance flow before publication.</p><p class="terms-source-note">References: <a href="https://www.gov.za/sites/default/files/gcis_document/201409/a25-02.pdf" target="_blank" rel="noreferrer">Electronic Communications and Transactions Act 25 of 2002 ↗</a> · <a href="https://www.dcdt.gov.za/documents/legislations/acts/file/116-electronic-communications-and-transactions-act-no-25-of-2002-pdf-footer.html" target="_blank" rel="noreferrer">DCDT source ↗</a></p>` },
  { number: 5, title: 'Eligibility', body: `<p>You must satisfy TRYP’s applicable age and legal requirements to create and use an account. TRYP may impose additional requirements for particular Services. You must not create an account if you are prohibited from using the Services under applicable law.</p>` },
  { number: 6, title: 'Passenger account', body: `<p>You may be required to create an account before requesting a Trip. You agree to provide accurate and current information, which may include your name, mobile number, email address, profile photograph, payment information and other information reasonably required by TRYP.</p>` },
  { number: 7, title: 'One account per person', body: `<p>Unless TRYP expressly permits otherwise, you may maintain only one personal passenger account. You must not create accounts to evade restrictions, create fraudulent accounts, use another person’s account, allow another person to use your account, exploit promotions through multiple accounts, or impersonate another person.</p><p>TRYP may suspend or terminate accounts associated with fraudulent or abusive activity.</p>` },
  { number: 8, title: 'Account security', body: `<p>You are responsible for maintaining the security of your account. Do not disclose passwords, OTPs, authentication codes or security credentials. Notify TRYP immediately if you believe someone has accessed your account without permission.</p><p>You are responsible for activity performed through your account unless the activity resulted from circumstances for which you are not legally responsible.</p>` },
  { number: 9, title: 'Requesting a ride', body: `<p>You may request a Trip through the App by entering the required information. Depending on the Services available in your area, you may select a pickup location, destination, ride category, payment method and other available options.</p><p>Submitting a ride request does not necessarily mean that a Driver has accepted it. A Trip becomes confirmed when TRYP communicates that a Driver has been assigned or otherwise confirms the Trip.</p>` },
  { number: 10, title: 'Driver matching', body: `<p>TRYP may use automated systems to identify Drivers who may be suitable for your Trip. Matching may consider Driver location, vehicle type, ride category, availability, distance, operational conditions, Driver status and other platform requirements.</p><p>TRYP does not guarantee that a Driver will always be available.</p>` },
  { number: 11, title: 'Driver information', body: `<p>Before or during a confirmed Trip, TRYP may provide information necessary to identify the Driver and Vehicle, including Driver name, photograph and rating, Vehicle make, model, colour and registration/licence plate, Vehicle location and estimated arrival time.</p><p>You must verify that the Vehicle and Driver correspond with the information displayed in the App before entering.</p>` },
  { number: 12, title: 'Do not enter the wrong Vehicle', body: `<p>For your own safety, verify the vehicle registration/licence plate, make and model, colour, and Driver information displayed in the App. If the information does not match, <strong>do not enter the Vehicle</strong>. Contact the Driver through the available TRYP communication function or contact support.</p>` },
  { number: 13, title: 'Driver’s right to refuse a Trip', body: `<p>A Driver may decline or cancel a Trip where permitted by law and TRYP policy, including because of safety concerns, Vehicle problems, Passenger behaviour, legal restrictions, accessibility or Vehicle limitations, incorrect pickup information, Passenger no-show or operational reasons.</p><p>Drivers must not unlawfully discriminate against passengers.</p>` },
  { number: 14, title: 'Passenger’s right to cancel', body: `<p>You may cancel a Trip before or after Driver assignment, subject to applicable cancellation rules. A cancellation fee may apply where a Driver has accepted the Trip, travelled toward the pickup point, arrived, you fail to appear within the waiting period, you repeatedly request and cancel Trips, or other circumstances specified in the App apply.</p><p>The applicable cancellation fee will be displayed where reasonably practicable.</p>` },
  { number: 15, title: 'Cancellation fees', body: `<p>Cancellation fees exist to compensate for reasonable costs associated with a Driver accepting a Trip and travelling toward the Passenger.</p><p>TRYP may waive or refund a fee where the Driver was substantially delayed, cancelled, arrived at the wrong location, a technical problem occurred, the fee was incorrectly charged, safety circumstances justified cancellation, or another adjustment is warranted. Contact support if you believe a fee was incorrect.</p>` },
  { number: 16, title: 'Passenger no-shows', body: `<p>If a Driver reaches the pickup location and you fail to appear within the applicable waiting period, the Driver may cancel the Trip. A no-show fee may apply where disclosed through the App. TRYP may consider the circumstances when reviewing a dispute.</p>` },
  { number: 17, title: 'Waiting time', body: `<p>Drivers may wait for a limited period after arriving at the pickup location. Where applicable, the App may display Driver arrival, waiting time, remaining waiting period and applicable waiting charges. You should be ready to enter the Vehicle when the Driver arrives.</p>` },
  { number: 18, title: 'Pickup locations', body: `<p>You are responsible for selecting a reasonably accurate and lawful pickup location. You must not ask a Driver to stop in an unsafe or prohibited location, enter restricted areas without permission, violate traffic laws or enter private property without authorisation.</p><p>Drivers may choose a safe and lawful pickup point if the selected location cannot reasonably be used.</p>` },
  { number: 19, title: 'Destination changes', body: `<p>You may request a destination change during a Trip where the feature is available. A Driver may accept or decline it where permitted by law, safety requirements or TRYP policy. A change may affect the Fare, route, duration, Driver availability and Trip eligibility. The App may update the estimated or final Fare.</p>` },
  { number: 20, title: 'Fares', body: `<p>The Fare may depend on ride category, distance, estimated or actual duration, pickup and destination, demand, tolls, waiting time, cancellation and other disclosed charges.</p><p>Where reasonably practicable, TRYP will display an estimated or upfront Fare before you confirm a Trip. An estimate is not necessarily the final Fare unless expressly identified as upfront or fixed.</p>` },
  { number: 21, title: 'Dynamic or demand-based pricing', body: `<p>TRYP may adjust pricing according to demand, availability and other operational factors. This may result in higher Fares during high demand, limited Driver availability, events, weather conditions, peak travel periods or other operational circumstances.</p><p>Where applicable, the increased price or estimated Fare will be displayed before you confirm.</p>` },
  { number: 22, title: 'Fare errors', body: `<p>If you believe a Fare is incorrect, contact support. TRYP may review GPS information, route, Trip duration, waiting time, ride category, payment records and other relevant information. If an error is identified, TRYP may make an appropriate adjustment or refund.</p>` },
  { number: 23, title: 'Tolls and additional charges', body: `<p>Where applicable, you may be responsible for toll fees, parking charges, airport access charges and other legally applicable Trip-related charges. Where such charges can reasonably be identified in advance, TRYP may include them in the Fare estimate.</p>` },
  { number: 24, title: 'Payment methods', body: `<p>TRYP may support bank cards, digital payments, cash and other payment methods. Available methods may differ by location. You agree to provide valid payment information where required.</p>` },
  { number: 25, title: 'Card payments', body: `<p>When you use a payment card, payment may be processed by a third-party provider. TRYP may not receive or store complete card information. Your payment may be subject to the provider’s terms.</p>` },
  { number: 26, title: 'Cash payments', body: `<p>Where cash payments are supported, you must pay the Driver the amount shown as payable. You must not intentionally refuse to pay, provide counterfeit money, misrepresent the amount paid or dishonestly dispute a legitimate cash payment. Repeated payment abuse may result in account restrictions.</p>` },
  { number: 27, title: 'Payment failures', body: `<p>If a digital payment fails, TRYP may retry the transaction, request another payment method, record an outstanding balance, restrict further Trips until the balance is resolved, or take other lawful steps. You remain responsible for legitimate charges incurred through your account.</p>` },
  { number: 28, title: 'Refunds', body: `<p>Where a refund is appropriate, TRYP may process it using the original payment method or another lawful method. Timing may depend on the payment provider. TRYP does not guarantee that a refund will appear immediately after approval.</p>` },
  { number: 29, title: 'Promotions and discounts', body: `<p>TRYP may offer promotional codes, discounts, referral bonuses, credits, free-trip promotions and other incentives. Promotions may have additional conditions. Unless expressly stated otherwise, they cannot be exchanged for cash, sold or transferred, may expire, and may not be exploited through multiple accounts. TRYP may cancel fraudulent promotional activity.</p>` },
  { number: 30, title: 'TRYP GO, COMFORT and XL', body: `<p><strong>TRYP GO</strong> is designed for everyday transportation and generally smaller passenger groups.</p><p><strong>TRYP COMFORT</strong> is designed to provide additional comfort and space, subject to Vehicle availability.</p><p><strong>TRYP XL</strong> is designed for larger groups or passengers requiring additional space, subject to capacity and applicable Vehicle requirements.</p><p>Vehicle availability and specifications may vary by location.</p>` },
  { number: 31, title: 'Passenger capacity', body: `<p>You must not exceed the legal or manufacturer-approved passenger capacity of a Vehicle. If your group exceeds the permitted capacity, request additional Vehicles where necessary. A Driver may refuse to transport passengers beyond lawful capacity.</p>` },
  { number: 32, title: 'Seatbelts', body: `<p>Passengers must use seatbelts where required by law. You must not ask a Driver to transport you in a manner that violates applicable safety laws. Children must be transported in accordance with applicable South African laws and safety requirements.</p>` },
  { number: 33, title: 'Children and minors', body: `<p>Passengers are responsible for ensuring that children travelling with them are appropriately supervised and transported. TRYP may impose rules concerning unaccompanied minors.</p><p>Unless TRYP expressly provides a verified minor or family service, you must not request a Trip for an unaccompanied child where doing so would violate applicable law or TRYP policy.</p>` },
  { number: 34, title: 'Assistance with children', body: `<p>Drivers are not automatically responsible for carrying children, installing child seats, supervising children or carrying children without a responsible adult. Passengers remain responsible for children travelling with them unless applicable law provides otherwise.</p>` },
  { number: 35, title: 'Passengers with disabilities', body: `<p>TRYP supports equal access to transportation and does not permit unlawful discrimination against passengers with disabilities. Passengers may notify TRYP of accessibility requirements.</p><p>Where a Vehicle or Driver cannot safely accommodate a particular requirement, TRYP may attempt to arrange a suitable alternative where available. Drivers may not refuse passengers merely because of a disability where doing so would be unlawful.</p>` },
  { number: 36, title: 'Service animals', body: `<p>Where required by applicable law, recognised service animals must be accommodated. TRYP may establish reasonable procedures to verify or manage service-animal transportation where permitted by law. A Driver may not refuse a passenger solely because they are accompanied by a lawful service animal where applicable law prohibits refusal.</p>` },
  { number: 37, title: 'Ordinary pets', body: `<p>Pets may be transported only where the Driver permits it, the ride category allows it, the animal is safely contained where reasonably required, and transportation complies with applicable law. TRYP may introduce a dedicated pet-friendly ride category.</p>` },
  { number: 38, title: 'Luggage and personal items', body: `<p>You are responsible for ensuring that luggage fits safely within the Vehicle, does not obstruct the Driver, does not create a safety hazard and does not damage the Vehicle. Drivers may refuse luggage that cannot safely be accommodated.</p>` },
  { number: 39, title: 'Prohibited items', body: `<p>You must not bring into a Vehicle illegal drugs, explosives, weapons where possession or transportation is unlawful, dangerous chemicals, flammable materials, hazardous biological materials or other dangerous goods prohibited by law. You must comply with laws concerning regulated goods.</p>` },
  { number: 40, title: 'Illegal activities', body: `<p>You must not use TRYP to commit or facilitate a crime, transport illegal goods, evade law enforcement, threaten another person, arrange unlawful transactions or transport prohibited materials. TRYP may cooperate with law enforcement where legally required or permitted.</p>` },
  { number: 41, title: 'Passenger conduct', body: `<p>Passengers must behave respectfully toward Drivers. You must not threaten, assault, harass, intimidate, stalk, sexually harass, discriminate against, abuse, extort, deliberately provoke or damage property belonging to a Driver or another passenger.</p>` },
  { number: 42, title: 'Sexual harassment and sexual misconduct', body: `<p>TRYP has zero tolerance for sexual harassment, unwanted sexual contact, sexual threats or comments, exposure, sexual assault, requests for sexual services and sexual intimidation. Serious incidents may result in immediate suspension and referral to law enforcement where appropriate.</p>` },
  { number: 43, title: 'Violence', body: `<p>You must never physically attack or threaten a Driver or passenger. A Driver may terminate a Trip where reasonably necessary to protect themselves or others. TRYP may immediately suspend accounts associated with credible reports of violence while an investigation takes place.</p>` },
  { number: 44, title: 'Harassment after a Trip', body: `<p>You must not use information obtained through TRYP to contact or pursue a Driver or passenger after a Trip for an unrelated purpose. This includes repeated personal calls, unwanted messages, visiting a person’s home, following, threatening or social-media harassment. Serious harassment may be reported to appropriate authorities.</p>` },
  { number: 45, title: 'Discrimination', body: `<p>TRYP does not permit unlawful discrimination based on protected characteristics. Passengers must not request, encourage or participate in discriminatory treatment of Drivers. Drivers are similarly subject to applicable anti-discrimination requirements.</p>` },
  { number: 46, title: 'Vehicle damage', body: `<p>You are responsible for damage caused by your intentional, reckless or negligent conduct to the extent permitted by law. Examples include deliberately damaging seats or components, spilling substances requiring professional cleaning, vomiting due to excessive intoxication where a reasonable charge is permitted, or deliberately damaging doors or windows.</p><p>TRYP may investigate the claim before charging or seeking recovery.</p>` },
  { number: 47, title: 'Cleaning fees', body: `<p>Where a Passenger causes extraordinary cleaning or damage requiring reasonable professional remediation, TRYP may charge a reasonable fee where legally permitted. TRYP should provide reasonable evidence or information supporting the charge upon request, subject to privacy and safety considerations.</p>` },
  { number: 48, title: 'Lost property', body: `<p>If you leave an item in a Vehicle, contact TRYP as soon as possible. TRYP may attempt to facilitate communication between you and the Driver but does not guarantee recovery. Drivers who find property should make reasonable efforts to return it through the appropriate TRYP process.</p>` },
  { number: 49, title: 'High-value or sensitive property', body: `<p>You remain responsible for valuable items such as cash, jewellery, passports, identity documents, computers, mobile phones and financial cards. You should check the Vehicle before leaving.</p>` },
  { number: 50, title: 'Driver-Passenger communication', body: `<p>Where available, TRYP may facilitate in-app messaging, masked calling or other temporary communication. Communications should be limited to legitimate Trip-related purposes. Users must not use these channels to harass or solicit one another for unrelated purposes.</p>` },
  { number: 51, title: 'Recording and monitoring', body: `<p>TRYP may introduce safety features involving audio, video, Trip monitoring, incident reporting or other safety technology. Where such features are introduced, TRYP will provide appropriate notices and comply with applicable law.</p>` },
  { number: 52, title: 'Emergency assistance', body: `<p>Where TRYP provides an emergency or safety feature, use it only when reasonably necessary. If there is an immediate threat to life or serious physical harm, contact appropriate emergency services directly where possible. TRYP may process and disclose relevant information during emergencies as permitted or required by law.</p>` },
  { number: 53, title: 'Driver safety', body: `<p>Drivers operate Vehicles in real-world environments. Passengers must not distract the Driver, interfere with Vehicle controls, demand dangerous driving, encourage speeding or illegal manoeuvres, open doors while moving, or exit the Vehicle in an unsafe location.</p>` },
  { number: 54, title: 'Driver route', body: `<p>Drivers may use navigation systems to determine an appropriate route. You may request a reasonable alternative route, but a Driver may decline a route that is unsafe, unlawful or unreasonable.</p>` },
  { number: 55, title: 'Driver identity and Vehicle requirements', body: `<p>TRYP may require Drivers and Vehicles to satisfy platform and regulatory requirements and may verify Driver identity, documentation, Vehicle information, Vehicle eligibility, safety requirements and other applicable requirements.</p><p>TRYP cannot guarantee that a Driver or Vehicle will never violate the law or platform rules.</p>` },
  { number: 56, title: 'Service availability', body: `<p>TRYP does not guarantee that Services will be available everywhere, at all times, without interruption or in every ride category. Availability may be affected by Driver supply, network connectivity, weather, traffic, public events, government restrictions, technical failures, emergencies or other circumstances outside TRYP’s reasonable control.</p>` },
  { number: 57, title: 'No guarantee of travel time', body: `<p>Estimated arrival and travel times are estimates and may change because of traffic, road closures, accidents, weather, construction, Driver location, navigation errors or other circumstances. TRYP does not guarantee arrival by a particular time unless a specific service expressly provides such a guarantee.</p>` },
  { number: 58, title: 'No guarantee of Driver availability', body: `<p>A request does not guarantee that a Driver will accept or complete the Trip. TRYP may attempt to find another Driver if the original Driver cancels.</p>` },
  { number: 59, title: 'Network and device requirements', body: `<p>You are responsible for having a compatible device, internet connectivity, a functioning mobile number where required, sufficient battery and necessary permissions. TRYP is not responsible for problems caused solely by your device, mobile network or internet provider.</p>` },
  { number: 60, title: 'Third-party services', body: `<p>TRYP may depend on third parties for maps, GPS, payments, SMS, WhatsApp, cloud infrastructure, authentication, notifications, analytics and other technical services. Third-party services may have separate terms and privacy policies. TRYP cannot guarantee uninterrupted availability of third-party infrastructure.</p>` },
  { number: 61, title: 'Maps and location information', body: `<p>Maps and GPS information may contain inaccuracies. You must not rely solely on the App’s location information where doing so would create a safety risk. Drivers and passengers should use reasonable judgment when determining a safe pickup or drop-off point.</p>` },
  { number: 62, title: 'Account suspension', body: `<p>TRYP may temporarily suspend an account where reasonably necessary to protect users, investigate fraud, serious complaints or safety incidents, protect payment systems, prevent unlawful activity or protect platform integrity. Where appropriate, TRYP may provide the Passenger with an opportunity to respond.</p>` },
  { number: 63, title: 'Account termination', body: `<p>TRYP may terminate an account where permitted by law if a Passenger seriously or repeatedly breaches these Terms, engages in fraud, violence or harassment, uses the platform unlawfully, abuses payment systems, creates fraudulent accounts, attempts to compromise TRYP systems or poses a serious safety risk.</p><p>Termination does not remove obligations that arose before termination.</p>` },
  { number: 64, title: 'Passenger account deletion', body: `<p>You may request deletion of your account. Certain information may need to be retained for legal compliance, tax, accounting, fraud prevention, dispute resolution, safety or legal claims. Account deletion is not necessarily immediate deletion of every record. The TRYP Privacy Policy explains data retention in greater detail.</p>` },
  { number: 65, title: 'Intellectual property', body: `<p>TRYP owns or has appropriate rights to use its branding, logos, application design, software, website content, graphics, text, images, interfaces, trademarks and other intellectual property.</p><p>You may not copy, reproduce, modify, distribute or commercially exploit TRYP intellectual property without permission.</p>` },
  { number: 66, title: 'Limited licence to use the App', body: `<p>Subject to these Terms, TRYP grants you a limited, personal, non-exclusive, non-transferable and revocable licence to use the App for its intended purpose.</p><p>You may not reverse engineer, decompile, extract source code, circumvent security, modify the App, create derivative versions, scrape the platform or interfere with platform operation. Nothing transfers ownership of TRYP intellectual property to you.</p>` },
  { number: 67, title: 'Prohibited technical activity', body: `<p>You must not introduce malware, attack TRYP systems, attempt unauthorised access, circumvent authentication, manipulate GPS information, interfere with dispatch systems, use bots to abuse the platform, scrape private information, reverse engineer security systems or conduct denial-of-service attacks. TRYP may take legal action where appropriate.</p>` },
  { number: 68, title: 'Fraud', body: `<p>Fraud includes false identities, fake Trips, payment manipulation, chargeback abuse, promotional abuse, account sharing, GPS manipulation, false complaints, false damage claims, collusion and attempts to manipulate ratings.</p><p>TRYP may investigate suspected fraud and take appropriate action.</p>` },
  { number: 69, title: 'Ratings and reviews', body: `<p>You may be invited to rate a Driver after a Trip. Ratings should be honest, relevant and based on your actual experience. You must not use ratings to threaten or extort a Driver, discriminate, obtain a dishonest refund or retaliate against a Driver for reporting misconduct. TRYP may remove ratings that violate platform rules where appropriate.</p>` },
  { number: 70, title: 'Complaints', body: `<p>You may submit complaints through TRYP support channels. A complaint should include enough information for TRYP to investigate. Where appropriate, TRYP may request Trip information, supporting evidence, photos, screenshots, payment information or other relevant details.</p>` },
  { number: 71, title: 'Dispute investigation', body: `<p>TRYP may investigate disputes using information available through the platform, including Trip records, GPS data, payment records, communication records, ratings, account history and information submitted by users.</p><p>TRYP may make reasonable determinations concerning platform-related disputes, subject to your rights under applicable law.</p>` },
  { number: 72, title: 'Refunds following disputes', body: `<p>Following an investigation, TRYP may issue a full or partial refund, waive a fee, correct a charge, decline a refund or take action against an account. The outcome may depend on the evidence available.</p>` },
  { number: 73, title: 'No retaliation', body: `<p>A Passenger must not retaliate against a Driver because the Driver reported misconduct, declined an unsafe request, reported a safety concern, participated in an investigation or exercised a legal right. TRYP may take action against retaliatory behaviour.</p>` },
  { number: 74, title: 'Safety reporting', body: `<p>Passengers are encouraged to report assault, harassment, unsafe driving, suspected intoxication, fraud, threats, theft, dangerous behaviour and other serious incidents as soon as reasonably possible.</p>` },
  { number: 75, title: 'False reports', body: `<p>You must not knowingly submit false or materially misleading complaints. A genuine complaint will not be treated as false merely because TRYP cannot independently verify it. Deliberate fabrication, fraud or malicious reporting may result in account action.</p>` },
  { number: 76, title: 'Intoxication', body: `<p>An intoxicated Passenger must not behave in a manner that endangers the Driver, damages the Vehicle, prevents safe transportation or threatens another person. A Driver may refuse or terminate transportation where reasonably necessary for safety and permitted by law.</p>` },
  { number: 77, title: 'Smoking and vaping', body: `<p>Smoking or vaping inside a Vehicle is prohibited unless expressly permitted by law and the Driver. TRYP may impose additional restrictions. Passengers who violate the rules may be charged reasonable cleaning costs where permitted by law.</p>` },
  { number: 78, title: 'Food and drink', body: `<p>Passengers should not consume food or beverages in a Vehicle where doing so could create a safety hazard, damage the Vehicle or create unreasonable cleaning requirements. Drivers may establish reasonable restrictions.</p>` },
  { number: 79, title: 'Driver independence', body: `<p>Where the legal and contractual structure provides for Drivers to operate independently, Drivers are responsible for their own conduct and compliance with applicable laws and regulatory requirements.</p><p>Nothing in these Passenger Terms removes any legal responsibility TRYP may itself have under applicable law.</p>` },
  { number: 80, title: 'Transport regulatory compliance', body: `<p>TRYP intends to operate its Services in accordance with applicable South African transportation laws and regulatory requirements. South Africa’s National Land Transport Act recognises electronic-hailing services and provides regulatory requirements concerning their operation.</p><p class="terms-source-note">Reference: <a href="https://www.gov.za/sites/default/files/gcis_document/201808/b7a-2016-nationallandtransport.pdf" target="_blank" rel="noreferrer">National Land Transport Act reference ↗</a></p><p>Drivers may therefore be required to hold appropriate licences, permits or operating authorisations. TRYP may suspend Drivers who do not satisfy applicable requirements.</p>` },
  { number: 81, title: 'Consumer rights', body: `<p>Nothing in these Terms is intended to deprive you of rights that cannot lawfully be excluded under the Consumer Protection Act or any other applicable law. The Consumer Protection Act establishes national norms and standards for consumer protection and addresses unfair business practices.</p><p>Where a provision conflicts with a mandatory statutory consumer right, the mandatory statutory provision will prevail to the extent of the conflict.</p><p class="terms-source-note">Reference: <a href="https://www.thedtic.gov.za/legislation/legislation-and-business-regulation/bills-and-acts/" target="_blank" rel="noreferrer">Department of Trade, Industry and Competition · Bills and Acts ↗</a></p>` },
  { number: 82, title: 'Limitation of liability', body: `<p>To the maximum extent permitted by law, TRYP will not be liable for loss that could not reasonably have been foreseen, results solely from circumstances outside TRYP’s reasonable control, results solely from your misuse of the Services, results from information you knowingly provided incorrectly, or results from unauthorised account use where you failed to take reasonable security precautions.</p><p>Nothing excludes or limits liability that cannot lawfully be excluded or limited, including liability arising from intentional misconduct, fraud, prohibited gross negligence exclusions, death or personal injury where liability cannot lawfully be excluded, statutory consumer rights or other prohibited exclusions.</p>` },
  { number: 83, title: 'Third-party conduct', body: `<p>TRYP facilitates interaction between passengers and Drivers and does not control every action a Driver takes. However, TRYP may vet Drivers according to applicable requirements, monitor platform activity, investigate complaints, suspend accounts, remove unsafe users and cooperate with authorities where appropriate.</p><p>Nothing removes rights you may have against TRYP or a Driver under applicable law.</p>` },
  { number: 84, title: 'Driver conduct and TRYP’s responsibility', body: `<p>TRYP recognises that passengers rely on the platform for transportation and does not simply disclaim responsibility for everything a Driver does. Where TRYP becomes aware of serious misconduct or safety concerns, it may investigate and take reasonable platform-level action, including temporary suspension, permanent removal, investigation, referral to authorities or additional verification.</p>` },
  { number: 85, title: 'Force majeure', body: `<p>TRYP will not be responsible for failure or delay caused by circumstances beyond its reasonable control, including natural disasters, floods, fires, severe weather, civil unrest, war, terrorism, government restrictions, major infrastructure or telecommunications failure, widespread cyber incidents, power outages, epidemics, pandemics or other extraordinary events.</p><p>This provision does not remove rights that cannot legally be excluded.</p>` },
  { number: 86, title: 'Changes to the Services', body: `<p>TRYP may add or remove features, change ride categories, modify the App, change pricing structures, introduce payment methods and modify operational procedures. Where a change materially affects your rights, TRYP will provide notice where required.</p>` },
  { number: 87, title: 'Changes to these Terms', body: `<p>TRYP may update these Terms. The updated Terms will display a new effective or last-updated date. Where legally required, TRYP will provide additional notice of material changes.</p><p>Continued use after the effective date may constitute acceptance to the extent permitted by law. If you do not agree to material changes, stop using TRYP and you may close your account.</p>` },
  { number: 88, title: 'Notices', body: `<p>TRYP may send notices through the App, email, SMS, push notification, website or other electronic means. You are responsible for maintaining access to the contact details associated with your account.</p>` },
  { number: 89, title: 'Customer support', body: `<p>TRYP may provide support through in-app support, email, telephone, website or other channels. Support availability may vary. TRYP does not guarantee immediate responses except where a specific emergency or safety feature provides otherwise.</p>` },
  { number: 90, title: 'Emergency support is not a substitute for emergency services', body: `<p>TRYP safety features are supplementary and do not replace police, ambulance services, fire services, hospitals or other emergency authorities. If immediate assistance is required, contact the appropriate emergency service.</p>` },
  { number: 91, title: 'Privacy', body: `<p>TRYP’s collection and processing of personal information is governed by the <a href="/privacy/">TRYP Privacy Policy</a>. It explains what information TRYP collects, why it is collected, how it is used and shared, how it is protected and your privacy rights. The Privacy Policy forms part of the overall TRYP legal framework.</p>` },
  { number: 92, title: 'Passenger information shared with Drivers', body: `<p>You acknowledge that certain information must be shared with a matched Driver to complete a Trip, including your name or display name, pickup, destination where necessary, profile photograph where applicable, Trip information and relevant communication information. TRYP will seek to minimise unnecessary disclosure.</p>` },
  { number: 93, title: 'Driver information shared with Passengers', body: `<p>You may receive information necessary to identify your Driver and Vehicle. You must not record it for harassment, publish it unnecessarily, sell it, use it to locate the Driver after the Trip or contact the Driver outside legitimate purposes.</p>` },
  { number: 94, title: 'Confidentiality after a Trip', body: `<p>The conclusion of a Trip does not give you permission to continue accessing or using information about the Driver. Likewise, Drivers may not use Passenger information after a Trip for unrelated purposes.</p>` },
  { number: 95, title: 'Government and law enforcement requests', body: `<p>TRYP may disclose information where required or permitted by law, including in response to court orders, warrants, lawful regulatory requests, criminal investigations, emergency requests or other legally authorised requests. Where legally permitted, TRYP may notify affected users.</p>` },
  { number: 96, title: 'Dispute resolution between Passenger and TRYP', body: `<p>If you have a complaint or dispute concerning TRYP, first contact TRYP and allow a reasonable opportunity for investigation. This does not remove any statutory right you may have to approach an applicable regulator, tribunal or court.</p>` },
  { number: 97, title: 'Legal rights and remedies', body: `<p>Nothing prevents you from exercising rights available under applicable South African law. Where appropriate, you may complain, seek statutory redress, approach a regulator, approach a court or seek other lawful remedies.</p>` },
  { number: 98, title: 'Governing law', body: `<p>These Terms are governed by the laws of the <strong>Republic of South Africa</strong>, unless applicable law requires otherwise.</p>` },
  { number: 99, title: 'Jurisdiction', body: `<p>Subject to mandatory consumer rights concerning jurisdiction, disputes involving TRYP may be brought before a court having lawful jurisdiction in South Africa. Nothing prevents a consumer from exercising a statutory right to approach a court, tribunal or other forum with jurisdiction.</p>` },
  { number: 100, title: 'Severability', body: `<p>If any provision is invalid, unlawful or unenforceable, the remaining provisions continue to apply to the extent permitted by law. The invalid provision should, where legally possible, be interpreted or modified to achieve the closest lawful result to the original intention.</p>` },
  { number: 101, title: 'No waiver', body: `<p>If TRYP does not immediately enforce a provision, that does not mean TRYP has permanently waived its right to enforce it.</p>` },
  { number: 102, title: 'Assignment', body: `<p>You may not transfer your TRYP account or rights under these Terms without TRYP’s written permission. TRYP may transfer or assign its rights and obligations where reasonably necessary for corporate restructuring, acquisition, merger, financing, sale of assets or another legitimate business purpose, subject to applicable law.</p>` },
  { number: 103, title: 'Entire agreement', body: `<p>These Terms, together with the TRYP Privacy Policy, applicable Driver Terms, Safety Policy, Cancellation and Refund Policy, Community Standards and feature-specific terms, form the relevant agreement governing your use of TRYP.</p><p>Where a feature-specific agreement conflicts with these Terms, it may prevail for that feature to the extent clearly stated.</p>` },
  { number: 104, title: 'No unlawful exclusion of rights', body: `<p>Nothing in these Terms excludes a right that cannot legally be excluded, prevents a statutory right, removes a mandatory consumer protection or prevents a regulator from exercising its powers.</p>` },
  { number: 105, title: 'TRYP’s right to protect the platform', body: `<p>TRYP may take reasonable measures to protect Passengers, Drivers, employees, contractors, payment systems, infrastructure, intellectual property and other users. Measures may include account restrictions, technical controls and investigations.</p>` },
  { number: 106, title: 'Passenger responsibility', body: `<p>You remain responsible for your own behaviour, the behaviour of people travelling with you, information entered into the App, payment obligations, account security, damage caused by you or your group, and compliance with these Terms.</p>` },
  { number: 107, title: 'Group bookings', body: `<p>If TRYP allows you to request a Trip for another person, you remain responsible for ensuring that person understands and follows applicable TRYP rules. You must not use the service to transport another person for an unlawful purpose.</p>` },
  { number: 108, title: 'Corporate or business bookings', body: `<p>Business customers may be subject to additional terms. Where an organisation creates or manages Trips for employees or other individuals, the organisation may be responsible for the relevant account and payment obligations according to the applicable agreement.</p>` },
  { number: 109, title: 'Accessibility and special requests', body: `<p>TRYP may provide additional accessibility features over time. Where you have a particular requirement, use the appropriate feature or notify TRYP before requesting a Trip where reasonably possible. TRYP cannot guarantee that every Vehicle will accommodate every requirement.</p>` },
  { number: 110, title: 'Service areas', body: `<p>TRYP may operate only in certain geographical areas. A service may be available in one city, unavailable in another, temporarily restricted or subject to regulatory requirements. TRYP may change its service areas.</p>` },
  { number: 111, title: 'Cross-border travel', body: `<p>A Driver may not be authorised or permitted to transport passengers across national borders. You must not request a cross-border Trip unless TRYP expressly indicates that the service is available and lawful.</p>` },
  { number: 112, title: 'Airports and restricted areas', body: `<p>Pickup and drop-off at airports, shopping centres, hospitals, gated communities and other controlled locations may be subject to access restrictions, parking rules, fees and designated pickup zones. Follow instructions provided through the App and by lawful authorities or facility operators.</p>` },
  { number: 113, title: 'Road safety', body: `<p>Passengers must not encourage a Driver to violate traffic laws, including requests to speed, run red lights, drive on prohibited roads, stop illegally, use restricted lanes unlawfully or drive while distracted.</p>` },
  { number: 114, title: 'No guarantee against accidents', body: `<p>TRYP takes reasonable measures to support safety but cannot guarantee that accidents, collisions, traffic incidents or other real-world events will never occur. Drivers remain responsible for operating Vehicles safely and in accordance with applicable law.</p>` },
  { number: 115, title: 'Insurance', body: `<p>Drivers and Vehicles may be required to maintain insurance or other legally required coverage. The existence, scope and limits of insurance depend on the relevant Driver, Vehicle, insurer and applicable law. TRYP does not represent that every possible loss will automatically be covered by insurance.</p>` },
  { number: 116, title: 'Accidents', body: `<p>If an accident occurs during a Trip: (1) prioritise immediate safety; (2) contact emergency services where necessary; (3) obtain medical assistance where necessary; (4) notify TRYP as soon as reasonably possible; and (5) provide accurate information. TRYP may investigate and cooperate with insurers or authorities where appropriate.</p>` },
  { number: 117, title: 'Medical emergencies', body: `<p>If you experience a medical emergency during a Trip, notify the Driver where reasonably possible and seek emergency medical assistance. Drivers are not automatically trained medical professionals and are not required to provide medical treatment beyond what they are legally and reasonably able to provide.</p>` },
  { number: 118, title: 'Lost children or vulnerable persons', body: `<p>If a vulnerable person is separated from their responsible adult during a Trip, contact TRYP and the appropriate authorities immediately where necessary. TRYP may cooperate with authorities to protect the person’s safety.</p>` },
  { number: 119, title: 'Security investigations', body: `<p>TRYP may investigate technical or security events affecting the platform. You agree not to interfere with investigations. Where required by law, TRYP may disclose relevant information to authorities.</p>` },
  { number: 120, title: 'Termination of the Services', body: `<p>TRYP may discontinue a particular service, ride category or feature. Where required by law, reasonable notice will be provided.</p>` },
  { number: 121, title: 'Survival', body: `<p>Provisions that logically continue after account termination remain in effect, including provisions concerning payment obligations, intellectual property, confidentiality, disputes, liability, fraud, legal compliance and data retention.</p>` },
  { number: 122, title: 'Contact information', body: `<div class="terms-contact-card"><strong>TRYP</strong><span>Legal Entity: [INSERT]</span><span>Registration Number: [INSERT]</span><span>Address: [INSERT]</span><a href="mailto:support@tryp.co.za">support@tryp.co.za</a><a href="mailto:legal@tryp.co.za">legal@tryp.co.za</a></div>` },
  { number: 123, title: 'Privacy contact', body: `<p>For privacy-related matters:</p><div class="terms-contact-card"><strong>Information Officer: [INSERT NAME]</strong><a href="mailto:privacy@tryp.co.za">privacy@tryp.co.za</a></div><p>Please refer to the <a href="/privacy/">TRYP Privacy Policy</a> for information concerning personal-information processing.</p>` },
  { number: 124, title: 'Final agreement', body: `<p>By using TRYP, you acknowledge that you understand:</p><ul><li>TRYP is an electronic platform for requesting transportation;</li><li>Drivers provide the transportation component of a Trip;</li><li>You must behave lawfully and respectfully;</li><li>You must provide accurate information and pay legitimate Fares;</li><li>You must follow safety requirements and respect Driver privacy;</li><li>You must not misuse the platform;</li><li>You have rights under applicable South African law;</li><li>TRYP has responsibilities to operate the platform reasonably and lawfully;</li><li>TRYP may act against users who threaten the safety or integrity of the platform.</li></ul>` },
];

const sectionLink = (number: number) => `#term-${number}`;
---
<SiteLayout title="Passenger Terms & Conditions — TRYP" description="Read the TRYP passenger Terms & Conditions covering rides, fares, safety, accounts, conduct and your rights under South African law." path="/terms/">
  <PageHero eyebrow="Passenger app · Legal" title={'The rules for<br /><em>moving together.</em>'} description="The terms, responsibilities and protections that govern your use of TRYP passenger services." />
  <ContentLayout items={[
    { href: '#overview', label: 'Overview' },
    { href: '#term-1', label: 'The service' },
    { href: '#term-9', label: 'Rides & fares' },
    { href: '#term-41', label: 'Safety & conduct' },
    { href: '#term-6', label: 'Accounts' },
    { href: '#term-81', label: 'Consumer rights' },
    { href: '#term-122', label: 'Contact' },
  ]}>
    <div class="policy-draft-banner terms-draft-banner" role="note">
      <div class="policy-draft-icon" aria-hidden="true">!</div>
      <div>
        <strong>Working draft · South African legal review required before publication</strong>
        <p>This passenger Terms & Conditions document is a structured draft for TRYP, not legal advice. Confirm the operating entity, driver relationship, fare and cancellation rules, safety policy, consumer notices, jurisdiction and contact details before launch.</p>
      </div>
    </div>

    <div class="policy-meta" id="overview">
      <div><span>Effective date</span><strong>[INSERT DATE]</strong></div>
      <div><span>Last updated</span><strong>[INSERT DATE]</strong></div>
      <div><span>Applies to</span><strong>TRYP passenger services</strong></div>
    </div>

    <div class="terms-agreement-intro">
      <p class="lead">These Passenger Terms & Conditions govern your access to and use of the TRYP passenger application, website, platform and related services.</p>
      <p>Please read these Terms carefully before using TRYP. By creating an account, accessing the application, requesting a ride, accepting a ride or otherwise using the TRYP Services, you agree to be bound by these Terms.</p>
      <p>If you do not agree with these Terms, you must not use the TRYP Services.</p>
    </div>

    <div class="terms-topic-strip" aria-label="Terms highlights">
      <a href="#term-9"><span>01</span><strong>Request a ride</strong><small>Bookings and matching</small></a>
      <a href="#term-20"><span>02</span><strong>Understand fares</strong><small>Pricing and payments</small></a>
      <a href="#term-41"><span>03</span><strong>Travel safely</strong><small>Conduct and reporting</small></a>
      <a href="#term-81"><span>04</span><strong>Know your rights</strong><small>CPA and remedies</small></a>
    </div>

    <nav class="terms-section-nav" aria-label="Terms sections">
      <strong>Jump to a section</strong>
      <div><a href={sectionLink(1)}>1–8 · Agreement & accounts</a><a href={sectionLink(9)}>9–28 · Trips & payments</a><a href={sectionLink(29)}>29–40 · Ride types & access</a><a href={sectionLink(41)}>41–61 · Safety & availability</a><a href={sectionLink(62)}>62–80 · Platform rules</a><a href={sectionLink(81)}>81–104 · Rights & legal terms</a><a href={sectionLink(105)}>105–124 · Operations & agreement</a></div>
    </nav>

    <div class="terms-sections" id="service">
      {terms.map((term) => (
        <section class:list={['policy-section', { 'terms-consumer-section': term.number === 81, 'terms-final-section': term.number === 124 }]} id={`term-${term.number}`}>
          <h2>{term.number}. {term.title}</h2>
          <div set:html={term.body}></div>
          {term.number === 81 && <div class="terms-callout"><strong>Your statutory rights remain.</strong><p>Nothing in these Terms is intended to contract out of mandatory consumer protections. The Consumer Protection Act and other applicable South African law continue to apply.</p></div>}
          {term.number === 124 && <div class="terms-acceptance-card"><span class="terms-acceptance-label">TRYP passenger agreement</span><strong>By selecting “Agree & Continue”, creating an account, requesting a Trip or using the TRYP Services, you acknowledge that you have read and accepted these Passenger Terms & Conditions and the TRYP Privacy Policy.</strong><div><span>Effective date: [INSERT DATE]</span><span>TRYP · [LEGAL ENTITY NAME]</span><span>[REGISTRATION NUMBER] · [SOUTH AFRICAN ADDRESS]</span><span>[WEBSITE] · [EMAIL]</span></div></div>}
        </section>
      ))}
    </div>

    <div class="terms-publication-note" id="contact">
      <strong>Before you put this into the TRYP app</strong>
      <p>Have the responsible legal owner confirm these four items before publication:</p>
      <ul>
        <li><strong>Who operates TRYP:</strong> the exact legal entity trading as TRYP, registration number and South African address.</li>
        <li><strong>The Driver relationship:</strong> alignment with the Driver Agreement and the actual legal and operating structure.</li>
        <li><strong>Fare and cancellation rules:</strong> the separate Fare, Cancellation & Refund Policy and the in-app disclosure flow.</li>
        <li><strong>Safety:</strong> the separate Safety & Emergency Policy covering emergency assistance, reporting, investigations and evidence.</li>
      </ul>
      <p>This page should be read together with the TRYP Privacy Policy and any feature-specific terms. It should not be published as “legally bulletproof”; South African consumer rights cannot simply be contracted away.</p>
      <div class="actions"><a class="button button-red" href="/privacy/">Read privacy policy <span>→</span></a><a class="button button-outline" href="mailto:legal@tryp.co.za">Contact legal <span>↗</span></a></div>
    </div>
  </ContentLayout>
</SiteLayout>
