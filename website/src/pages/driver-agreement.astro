---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentLayout from '../components/ContentLayout.astro';

interface AgreementSection { number: number; title: string; body: string; emphasis?: string; }

const rawSections: [number, string, string, string?][] = [
  [1, 'Parties', 'This Driver Agreement ("Agreement") is entered into between <strong>Hungry Development (Pty) Ltd</strong>, trading as <strong>TRYP</strong> ("TRYP", "we", "us" or "our"), and the individual or legal entity approved to provide transportation services through the TRYP Platform ("Driver", "you" or "your"). TRYP and the Driver are individually a Party and collectively the Parties.'],
  [2, 'Purpose of this Agreement', 'This Agreement establishes the contractual relationship between TRYP and the Driver. It governs Platform access, onboarding, eligibility, Vehicles, Trip acceptance, Earnings, fees, payments, taxes, insurance, regulatory compliance, responsibilities, safety, Passenger interactions, intellectual property, confidentiality, data protection, suspension, termination and dispute resolution.'],
  [3, 'The TRYP business model', 'TRYP operates a technology Platform that facilitates connections between Passengers seeking transportation and Drivers offering transportation services. The Platform may provide Trip requests, matching, fare calculations, navigation assistance, payments, Trip records, safety features, communications, ratings and support. Unless expressly stated otherwise, TRYP does not own or operate the Vehicle used by the Driver.'],
  [4, 'Driver status', 'Subject to applicable law and the actual circumstances of the relationship, the Parties intend that the Driver operates as an <strong>independent contractor</strong> and not as an employee of TRYP. The Driver operates their own transportation business and uses TRYP as a technology and marketplace Platform. Nothing in this Agreement unlawfully determines or excludes a status that applies under mandatory South African law. The actual relationship must remain consistent with this arrangement.','regulatory'],
  [5, 'No guarantee of work', 'TRYP does not guarantee a minimum number of Trips, income, hours, Passenger requests or Earnings. The Driver decides whether and when to make themselves available, subject to applicable law and Platform rules.'],
  [6, 'Driver flexibility', 'Subject to law and Platform requirements, the Driver may generally determine when to go online or offline, whether to accept available Trips, how many hours to operate and whether to use other lawful platforms. TRYP does not guarantee that Trips will be available whenever the Driver chooses to operate.'],
  [7, 'No exclusive service requirement', 'Unless separately agreed in writing, TRYP does not require exclusive service. The Driver may use other lawful platforms or operate independently, provided this does not breach this Agreement, misuse TRYP information, create a safety conflict, involve Passenger solicitation using TRYP data or breach law.'],
  [8, 'Driver’s business', 'The Driver is responsible for operating their transportation activity lawfully, including the Vehicle, fuel, maintenance, licensing, permits, insurance, taxes, traffic-law compliance, equipment and operating expenses.'],
  [9, 'Driver eligibility', 'To use TRYP, the Driver must satisfy requirements established by TRYP, transport legislation, licensing authorities, road-traffic law and other applicable laws and regulations.'],
  [10, 'Identity verification', 'TRYP may verify identity, photograph, contact information, address where legally necessary, driving credentials, permits and other legally required information. False information may result in rejection, suspension or termination.'],
  [11, 'Driver Documents', 'The Driver must provide valid requested Documents, which may include an identity document, driver’s licence, professional driving permit, operating licence, Vehicle registration, inspection information, insurance and other required documentation.'],
  [12, 'Operating licence', 'The Driver must maintain every operating licence required by law. South Africa’s current framework recognises e-hailing as a public-transport service and requires applicable operators to hold valid operating licences. The amended framework commenced on <strong>12 September 2025</strong>. TRYP may prevent a Vehicle from providing Trips if required documentation is invalid or unavailable. See the <a href="https://www.gov.za/news/media-statements/transport-gazettes-national-land-transport-amendment-act-and-regulations-e" target="_blank" rel="noreferrer">South African Government e-hailing framework ↗</a>.','regulatory'],
  [13, 'Driver licence', 'The Driver must maintain a valid driver’s licence appropriate for the Vehicle and service being provided.'],
  [14, 'Professional driving permit', 'Where applicable, the Driver must maintain the required professional driving permit or equivalent legal credential.'],
  [15, 'Vehicle ownership', 'The Vehicle need not be owned by the Driver if lawful use can be established. The Driver must have lawful authority to use the Vehicle for TRYP services.'],
  [16, 'Vehicle requirements', 'The Vehicle must satisfy TRYP requirements concerning age, condition, model, capacity, safety, appearance, licensing, insurance, accessibility and required equipment.'],
  [17, 'Vehicle information', 'The Driver must provide accurate Vehicle make, model, year, registration, colour, identification, insurance and operating-licence information.'],
  [18, 'Vehicle substitution', 'The Driver may not use another Vehicle without approval where approval is required. Passengers must be able to reasonably verify that the arriving Vehicle corresponds with the App.'],
  [19, 'Vehicle safety', 'The Driver must maintain the Vehicle in a condition suitable for lawful passenger transportation.'],
  [20, 'Vehicle maintenance', 'The Driver is responsible for servicing, tyres, brakes, lights, windscreen, seatbelts, doors, mirrors and general mechanical condition.'],
  [21, 'Vehicle cleanliness', 'The Driver must maintain a reasonably clean Passenger environment suitable for transportation.'],
  [22, 'Vehicle identification', 'The Driver must comply with e-hailing identification and branding requirements. South Africa’s framework requires e-hailing Vehicles to be appropriately identified; do not use unauthorised TRYP branding.','regulatory'],
  [23, 'Vehicle inspection', 'TRYP may require evidence of inspection or compliance checks and may refuse Vehicle activation until satisfactory Documents are provided.'],
  [24, 'TRYP Vehicle categories', 'TRYP may offer GO, COMFORT, XL and additional categories. Each may have separate Vehicle requirements, Fare structures, capacity and eligibility requirements.'],
  [25, 'Driver approval for categories', 'TRYP may determine which categories a Driver and Vehicle may access. A Driver must not represent an ordinary Vehicle as belonging to a higher category.'],
  [26, 'Driver Account', 'The Driver receives access to a TRYP Driver Account and is responsible for maintaining its security.'],
  [27, 'Account passwords', 'Keep authentication information confidential and never give login credentials to another person.'],
  [28, 'Account sharing', 'Account sharing is prohibited. Another person may not provide Trips under the Driver’s Account.','serious'],
  [29, 'Account rental', 'The Driver may not rent, sell or transfer the Account.','serious'],
  [30, 'Account security', 'If the Driver suspects unauthorised access, notify TRYP promptly. TRYP may temporarily restrict the Account to protect the Driver and Platform.'],
  [31, 'Driver App', 'Use the official TRYP application or authorised software. Do not use modified or unofficial versions designed to manipulate Platform functionality.'],
  [32, 'Device requirements', 'The Driver is responsible for a compatible device, data, charging and network access capable of running the Driver App.'],
  [33, 'GPS', 'The Driver must provide reasonably accurate location information. GPS spoofing and location manipulation are prohibited.','serious'],
  [34, 'Trip requests', 'TRYP may transmit Trip requests based on available Platform functionality. The Driver may accept or decline requests according to Platform rules.'],
  [35, 'Acceptance of a Trip', 'After accepting a Trip, the Driver is expected to make reasonable efforts to complete it safely and lawfully.'],
  [36, 'Trip cancellation', 'A Driver may cancel where reasonably necessary, including for safety concerns, Vehicle problems, Passenger misconduct, inability to locate the Passenger, legal restrictions or emergency.'],
  [37, 'Cancellation abuse', 'The Driver must not deliberately manipulate cancellation systems.','moderate'],
  [38, 'Passenger pickup', 'Make reasonable efforts to collect the Passenger at the designated pickup location without creating unnecessary inconvenience or stopping unsafely or illegally.'],
  [39, 'Trip completion', 'Complete the Trip at the appropriate destination unless the Passenger requests a change, safety requires otherwise, the Vehicle cannot continue, law requires otherwise or an emergency occurs.'],
  [40, 'Fare estimation', 'The Platform may provide an estimated Fare before the Trip. South African law requires an e-hailing application to provide fare and distance estimates electronically in advance. See the <a href="https://www.gov.za/sites/default/files/gcis_document/202406/50800nationallandtransportamendmentact232023.pdf" target="_blank" rel="noreferrer">National Land Transport Amendment Act reference ↗</a>.','regulatory'],
  [41, 'Final Fare', 'The final Fare may depend on applicable TRYP pricing rules and actual Trip circumstances. The Platform should communicate the final Fare electronically.'],
  [42, 'Driver Earnings', 'Earnings are calculated under the applicable model, which may consider Fare, Platform fee, promotions, adjustments, tolls, refunds and other permitted adjustments.'],
  [43, 'Platform fee', 'TRYP may charge a Platform fee or commission. The applicable fee will be disclosed through the Platform or commercial terms.'],
  [44, 'Changes to fees', 'TRYP may change Platform fees. Where a material change affects the Earnings structure, TRYP should provide reasonable notice through the Platform or another appropriate channel.'],
  [45, 'Taxes', 'The Driver is responsible for determining and meeting applicable tax obligations unless law requires TRYP to withhold or account for a tax. SARS states that tax treatment depends on the contractual relationship and statutory rules. Review the <a href="https://www.sars.gov.za/legal-counsel/interpretation-rulings/interpretation-notes/in-1-20/" target="_blank" rel="noreferrer">SARS independent-contractor guidance ↗</a>.','regulatory'],
  [46, 'Tax registration', 'Where legally required, the Driver must register with SARS or another relevant authority.'],
  [47, 'Tax records', 'Retain records concerning Earnings, expenses, Platform fees, fuel, maintenance, insurance and other business expenses.'],
  [48, 'VAT', 'Where applicable, the Driver is responsible for VAT compliance and should obtain professional tax advice where necessary.'],
  [49, 'Driver expenses', 'Unless expressly stated otherwise, the Driver is responsible for fuel, maintenance, tyres, insurance, data, device costs, parking, licensing, taxes and tolls not separately reimbursed.'],
  [50, 'Payouts', 'TRYP may pay Driver Earnings to the nominated payment method.'],
  [51, 'Payment information', 'Provide accurate banking or payment information. TRYP is not responsible for delays caused by incorrect information supplied by the Driver.'],
  [52, 'Payment processing', 'Payment processing may involve third-party financial institutions or providers whose terms may also apply.'],
  [53, 'Payment disputes', 'If the Driver believes an Earnings calculation is incorrect, they may submit a dispute through the designated TRYP process.'],
  [54, 'Refunds', 'Where a Passenger receives a refund, TRYP may make an appropriate adjustment to Driver Earnings where permitted by the applicable Earnings rules.'],
  [55, 'Fraudulent Earnings', 'TRYP may withhold or reverse Earnings reasonably believed to result from Fake Trips, GPS or Fare manipulation, payment fraud, promotion abuse or Account fraud.','serious'],
  [56, 'No guarantee of income', 'TRYP makes no representation that Drivers will earn a particular amount. Earnings depend on demand, availability, location, time, pricing, competition, acceptance and market conditions.'],
  [57, 'Promotions', 'TRYP may offer Driver promotions or incentives, each with separate eligibility requirements.'],
  [58, 'Promotion abuse', 'Drivers must not manipulate promotions through fake Accounts, Fake Trips, self-referrals or coordinated activity.','serious'],
  [59, 'Driver tips', 'Where tipping is available, TRYP may pass applicable tips to the Driver subject to Platform payment rules.'],
  [60, 'Cash Trips', 'Where cash is enabled, collect the correct Fare, record the Trip accurately, avoid double charging and report payment disputes honestly.'],
  [61, 'No off-Platform Fares', 'Drivers must not deliberately divert TRYP Passengers into private transportation arrangements to avoid applicable TRYP fees.','serious'],
  [62, 'Passenger solicitation', 'Do not use Passenger information obtained through TRYP to solicit private business outside the Platform.','serious'],
  [63, 'Independent business', 'The Driver may operate a lawful transportation business outside TRYP, but may not use confidential TRYP or Passenger information to compete improperly against TRYP.'],
  [64, 'Insurance', 'The Driver must maintain all insurance legally required for the Vehicle and services provided.'],
  [65, 'Insurance disclosure', 'TRYP may request proof of insurance. Failure to provide required proof may result in temporary Vehicle deactivation.'],
  [66, 'Accidents and claims', 'Promptly report relevant accidents and insurance claims connected with TRYP Trips.'],
  [67, 'Driver responsibility for Vehicle', 'The Driver remains responsible for lawful operation and maintenance of the Vehicle. TRYP does not become the owner merely because the Driver uses the Platform.'],
  [68, 'Traffic law', 'The Driver must comply with applicable traffic laws.'],
  [69, 'Fines', 'Unless required by law or caused by TRYP’s own conduct, the Driver is responsible for traffic fines arising from the Driver’s conduct.'],
  [70, 'Tolls', 'Tolls are handled according to applicable TRYP Fare and payment rules.'],
  [71, 'Parking', 'The Driver is responsible for lawful parking.'],
  [72, 'Driver conduct', 'The Driver must comply with the separate <a href="/driver-code/">TRYP Driver Code of Conduct</a>, which forms part of the Driver’s obligations under this Agreement.'],
  [73, 'Safety', 'The Driver must comply with the <a href="/safety-policy/">TRYP Safety & Emergency Response Policy</a>.','regulatory'],
  [74, 'Passenger information', 'The Driver may receive personal information necessary to complete Trips. This information remains protected information.'],
  [75, 'Use of Passenger data', 'Passenger information may only be used for completing Trips, legitimate communication, safety, lost property and other authorised TRYP purposes.'],
  [76, 'No data harvesting', 'Drivers must not create personal databases of TRYP Passengers.','serious'],
  [77, 'POPIA', 'The Driver must handle personal information under applicable South African data-protection requirements and TRYP’s Privacy Policy.'],
  [78, 'Confidentiality', 'Keep confidential Passenger information, TRYP business and pricing information, security information, Platform information and non-public technical information.'],
  [79, 'Confidentiality after termination', 'Confidentiality obligations continue after the Driver stops using TRYP while the information remains confidential.'],
  [80, 'Intellectual property', 'TRYP owns or licenses rights in its name, logo, applications, website, software, designs, content, Platform technology and trademarks.'],
  [81, 'Limited licence', 'TRYP grants a limited, revocable, non-exclusive licence to use the Platform and branding solely for authorised TRYP activities.'],
  [82, 'No ownership', 'Using TRYP does not give the Driver ownership of TRYP software, trademarks, Passenger databases, Platform technology or content.'],
  [83, 'Brand misuse', 'Do not use TRYP branding to misrepresent TRYP, suggest employment where none exists, suggest government affiliation or damage the brand.'],
  [84, 'Feedback', 'If the Driver provides suggestions or feedback, TRYP may use it to improve services subject to applicable law.'],
  [85, 'Driver content', 'If the Driver voluntarily submits photographs, videos, reviews or other content, applicable rights and permissions are governed by relevant Platform terms.'],
  [86, 'Platform security', 'Do not hack, reverse engineer maliciously, circumvent security, scrape, extract confidential data or introduce malicious code.','serious'],
  [87, 'Bots', 'Automated tools designed to manipulate Trip allocation, incentives or Platform functionality are prohibited.','serious'],
  [88, 'Multiple Accounts', 'Drivers must not maintain multiple Driver Accounts to evade restrictions or manipulate the Platform.','serious'],
  [89, 'Third-party software', 'Do not use third-party software that materially interferes with TRYP security or fair operation.'],
  [90, 'Rating system', 'TRYP may use a rating and feedback system intended to promote service quality and safety.'],
  [91, 'Rating manipulation', 'Do not purchase ratings, threaten Passengers over ratings, create fake Passenger Accounts or coordinate artificial ratings.','serious'],
  [92, 'Driver support', 'TRYP may provide customer and Driver support. Availability may vary with operating hours, incident severity, service availability and technical conditions.'],
  [93, 'Safety support', 'Serious safety incidents may be handled through specialised procedures. Emergency services remain the first point of contact for immediate threats to life.','critical'],
  [94, 'Platform availability', 'TRYP attempts reliable availability but does not guarantee uninterrupted operation. Maintenance, networks, cloud services, devices, cyber incidents and third-party interruptions may affect the Platform.'],
  [95, 'App failure', 'The Driver must not provide a Trip where law or TRYP rules require the application to function and it is not operating properly. South African legislation addresses operation where the relevant application is not working properly; this requirement must be confirmed against the live regulatory implementation.','regulatory'],
  [96, 'Platform changes', 'TRYP may modify Features, interface, pricing, matching, Driver requirements, safety systems and payment methods.'],
  [97, 'Regulatory changes', 'TRYP may modify this Agreement and Platform requirements when necessary to comply with changes in South African law or regulation.'],
  [98, 'Driver compliance', 'The Driver remains responsible for laws applicable to their own conduct.'],
  [99, 'Subcontracting', 'The Driver may not subcontract Trips to another person through their Driver Account.','serious'],
  [100, 'Driver personally provides service', 'The Driver Account belongs to the approved Driver. Another person may not secretly perform Trips under the Driver’s identity.','serious'],
  [101, 'No employee benefits', 'To the extent the Driver lawfully operates as an independent contractor, the Driver is not entitled solely by this Agreement to employee benefits such as annual leave, sick leave, employer pension contributions, medical benefits or employee bonuses. Mandatory legal rights, if applicable, are not excluded.','regulatory'],
  [102, 'Control and independence', 'TRYP rules concerning safety, Passenger protection, fraud prevention, legal compliance, data security and service standards do not by themselves create a right to unlawfully control the Driver’s working hours or general personal affairs.'],
  [103, 'Driver’s right to decline work', 'Subject to law and Platform rules, the Driver may choose whether to make themselves available and whether to accept available Trip requests.'],
  [104, 'No minimum hours', 'TRYP does not require fixed operating hours unless a separate lawful arrangement expressly provides otherwise.'],
  [105, 'Driver’s other activities', 'The Driver may engage in other lawful economic activities.'],
  [106, 'Non-solicitation', 'During and after use of TRYP, the Driver must not improperly use Passenger information obtained through TRYP to solicit Passengers for unrelated commercial transportation services.','serious'],
  [107, 'No customer database', 'A Driver may not copy or export TRYP Passenger information to create an independent customer database.','serious'],
  [108, 'Conflicts', 'The Driver must avoid conduct creating a material conflict between TRYP obligations and another business activity.'],
  [109, 'Compliance audits', 'TRYP may conduct reasonable checks concerning Driver identity, Vehicle, licensing, insurance, safety, fraud and Account integrity.'],
  [110, 'Document expiry', 'TRYP may notify Drivers when required Documents approach expiry. The Driver remains responsible for renewing them.'],
  [111, 'Invalid Documents', 'If a required Document expires or becomes invalid, the Driver must not continue providing affected services.','regulatory'],
  [112, 'False Documents', 'Submitting forged or altered Documents is grounds for immediate action.','serious'],
  [113, 'Criminal conduct', 'TRYP may restrict or terminate access where legally appropriate following serious criminal conduct connected to Platform use.','critical'],
  [114, 'Investigations', 'TRYP may investigate suspected fraud, safety violations, Account sharing, identity fraud, payment manipulation, privacy violations and other serious misconduct.'],
  [115, 'Temporary suspension', 'TRYP may temporarily suspend access while investigating serious matters.'],
  [116, 'Immediate safety suspension', 'Where there is a credible and serious safety risk, TRYP may restrict access immediately while further information is obtained.','critical'],
  [117, 'Suspension is not automatic guilt', 'Temporary suspension is not necessarily a final finding of misconduct.'],
  [118, 'Driver response', 'Where reasonably appropriate, TRYP may provide the Driver an opportunity to respond to allegations.'],
  [119, 'Appeal', 'Where an appeal mechanism is provided, the Driver may appeal according to the applicable process.'],
  [120, 'Termination by Driver', 'The Driver may stop using TRYP at any time, subject to completing or properly cancelling active Trips and resolving outstanding matters.'],
  [121, 'Termination by TRYP', 'TRYP may terminate this Agreement where permitted by law for serious breach, fraud, safety violations, invalid licensing, Account sharing, Platform abuse, repeated violations, eligibility failure or regulatory requirements.'],
  [122, 'Immediate termination', 'Serious misconduct may justify immediate termination, subject to applicable law and any legally required process.','critical'],
  [123, 'Termination for regulatory non-compliance', 'TRYP may suspend or terminate access where continuing would cause TRYP or the Driver to breach applicable transport law.','regulatory'],
  [124, 'Effect of termination', 'After termination, the Driver must stop representing themselves as a TRYP Driver, stop using TRYP branding and the Platform, return or delete confidential information where required and resolve outstanding payment matters.'],
  [125, 'Outstanding Earnings', 'Termination does not automatically eliminate legitimate Earnings already earned. TRYP may make lawful adjustments for refunds, fraud, reversals, amounts owed and other legitimate adjustments.'],
  [126, 'Surviving Terms', 'Confidentiality, intellectual property, data protection, outstanding payment obligations, disputes, liability and provisions intended by their nature to survive may continue after termination.'],
  [127, 'Driver indemnification', 'To the extent permitted by law, the Driver may be responsible for losses arising from unlawful conduct, fraud, deliberate misconduct, serious negligence or breach. This does not exclude liability that cannot legally be excluded.'],
  [128, 'TRYP responsibility', 'Nothing in this Agreement excludes or limits liability that TRYP cannot lawfully exclude or limit.'],
  [129, 'No unlawful exclusion', 'No clause removes mandatory statutory rights, excludes prohibited liability, prevents a Driver approaching a competent authority or prevents reporting criminal conduct.'],
  [130, 'Force majeure', 'Neither Party may be responsible for failure caused by circumstances beyond reasonable control, subject to law. Examples include natural disasters, major outages, war, civil unrest, government restrictions and widespread infrastructure failure.'],
  [131, 'Dispute resolution', 'The Parties should first attempt to resolve contractual disputes through TRYP’s internal support process. If unresolved, the matter may be referred to the appropriate South African legal forum.'],
  [132, 'Applicable law', 'This Agreement is governed by the laws of the <strong>Republic of South Africa</strong>, subject to mandatory legal requirements applicable to the relationship.'],
  [133, 'Jurisdiction', 'Subject to applicable law, disputes may be brought before a competent South African court or other legally appropriate forum.'],
  [134, 'Changes to Agreement', 'TRYP may update this Agreement where reasonably necessary. Material changes should be communicated to Drivers through appropriate channels.'],
  [135, 'Driver acceptance', 'Before activating Driver access, TRYP may require electronic confirmation: <blockquote>“I have read and agree to the TRYP Driver Agreement.”</blockquote> The acceptance record may include Driver identity, date, time, Agreement version, device information and other legally relevant information.'],
  [136, 'Electronic acceptance', 'Electronic acceptance may constitute acceptance where legally valid. TRYP may retain acceptance records.'],
  [137, 'Severability', 'If a provision is invalid or unenforceable, the remaining provisions continue to operate to the extent permitted by law.'],
  [138, 'Entire agreement', 'This Agreement, together with incorporated TRYP policies and applicable commercial terms, constitutes the contractual framework governing the Driver’s use of TRYP, subject to mandatory law.'],
  [139, 'Document hierarchy', '<ol><li>South African law and binding regulatory requirements</li><li>Mandatory regulatory conditions</li><li>This Driver Agreement</li><li>TRYP Driver Code of Conduct</li><li>TRYP Safety & Emergency Response Policy</li><li>Other Platform policies</li><li>Trip-specific information</li></ol><p>Where a conflict exists, mandatory law prevails.</p>'],
  [140, 'Driver acknowledgement', 'By accepting this Agreement, the Driver confirms that TRYP is a technology Platform; they are responsible for their Vehicle, licences, lawful operation and taxes; they must follow the Driver Code and Safety Policy; they must protect Passenger information; they must not manipulate the Platform; and serious misconduct may result in suspension or termination.'],
  [141, 'Final Driver declaration', '<div class="declaration-list"><strong>I confirm that the information I have provided to TRYP is accurate and complete.</strong><strong>I confirm that I am legally permitted to provide the relevant transportation services.</strong><strong>I agree to maintain required licences, permits, insurance and Vehicle standards.</strong><strong>I agree to operate safely and lawfully and treat Passengers with dignity.</strong><strong>I agree not to manipulate the TRYP Platform.</strong><strong>I agree to protect Passenger and TRYP information.</strong><strong>I understand that serious violations may result in immediate suspension or termination.</strong><strong>I understand that this Agreement does not remove rights or obligations imposed by South African law.</strong></div>'],
];

const sections: AgreementSection[] = rawSections.map(([number, title, body, emphasis]) => ({ number, title, body, emphasis }));
const sectionLink = (number: number) => `#agreement-${number}`;
---
<SiteLayout title="Driver Agreement & Independent Contractor Terms — TRYP" description="Read the TRYP Driver Agreement covering the commercial relationship, independent-contractor intention, earnings, compliance, data protection and termination." path="/driver-agreement/">
  <PageHero eyebrow="Driver app · Commercial agreement" title={'The agreement for<br /><em>driving with TRYP.</em>'} description="The commercial relationship, responsibilities and platform terms that apply when you operate as a TRYP Driver." />
  <ContentLayout items={[
    { href: '#overview', label: 'Overview' },
    { href: '#agreement-1', label: 'The relationship' },
    { href: '#agreement-9', label: 'Eligibility & Vehicles' },
    { href: '#agreement-40', label: 'Fares & Earnings' },
    { href: '#agreement-64', label: 'Insurance & data' },
    { href: '#agreement-101', label: 'Independence' },
    { href: '#agreement-114', label: 'Suspension & termination' },
    { href: '#agreement-135', label: 'Acceptance' },
  ]}>
    <div class="policy-draft-banner agreement-draft-banner" role="note"><div class="policy-draft-icon" aria-hidden="true">§</div><div><strong>Strong commercial draft · South African legal review required</strong><p>This Agreement is a working commercial draft, not legal advice. Calling a Driver an independent contractor does not determine legal status by itself; the substance of the relationship, actual rights, obligations and degree of control must match the final operating model.</p></div></div>
    <div class="policy-meta" id="overview"><div><span>Company</span><strong>Hungry Development (Pty) Ltd / TRYP</strong></div><div><span>Effective date</span><strong>[INSERT DATE]</strong></div><div><span>Version · jurisdiction</span><strong>1.0 · Republic of South Africa</strong></div></div>
    <div class="agreement-intro"><p class="lead">This Agreement governs the commercial relationship between TRYP and the Driver who uses the TRYP Passenger & Driver Platform.</p><p>It sits alongside the Driver Terms, Driver Code of Conduct, Safety & Emergency Response Policy, Privacy Policy and applicable commercial schedules. It does not contract around mandatory South African law.</p></div>
    <nav class="agreement-topic-strip" aria-label="Driver Agreement highlights"><a href="#agreement-4"><span>01</span><strong>Relationship</strong><small>Independent-contractor intention, subject to law</small></a><a href="#agreement-16"><span>02</span><strong>Operate lawfully</strong><small>Vehicles, licences, insurance and safety</small></a><a href="#agreement-40"><span>03</span><strong>Understand money</strong><small>Fares, fees, taxes and payouts</small></a><a href="#agreement-114"><span>04</span><strong>Fair process</strong><small>Reviews, appeals and termination</small></a></nav>
    <nav class="terms-section-nav agreement-section-nav" aria-label="Driver Agreement sections"><strong>Jump to a section</strong><div><a href={sectionLink(1)}>1–8 · Relationship & business</a><a href={sectionLink(9)}>9–25 · Eligibility & Vehicles</a><a href={sectionLink(26)}>26–39 · Account & Trips</a><a href={sectionLink(40)}>40–63 · Fares & Earnings</a><a href={sectionLink(64)}>64–89 · Insurance, data & IP</a><a href={sectionLink(90)}>90–113 · Platform & compliance</a><a href={sectionLink(114)}>114–126 · Enforcement & exit</a><a href={sectionLink(127)}>127–141 · Legal terms & acceptance</a></div></nav>
    <div class="agreement-sections">{sections.map((section) => <section class:list={['policy-section', `agreement-emphasis-${section.emphasis ?? 'standard'}`, { 'agreement-final-section': section.number === 141 }]} id={`agreement-${section.number}`}><h2>{section.number}. {section.title}</h2><div set:html={section.body}></div>{section.number === 4 && <div class="agreement-callout"><strong>Status follows substance.</strong><p>The final contract, app design and day-to-day operating model must be reviewed together. See the <a href="https://www.sars.gov.za/legal-counsel/interpretation-rulings/interpretation-notes/in-1-20/" target="_blank" rel="noreferrer">SARS independent-contractor guidance ↗</a>.</p></div>}{section.number === 12 && <div class="agreement-callout"><strong>Regulatory compliance is a condition of operation.</strong><p>TRYP may disconnect a Vehicle or Driver until required documentation is valid and verified.</p></div>}{section.number === 73 && <div class="agreement-callout"><strong>Read the incorporated policy.</strong><p>The Safety Policy provides the operational emergency framework; immediate threats should be directed to emergency services first.</p></div>}{section.number === 141 && <div class="agreement-acceptance-card"><span class="agreement-acceptance-label">Driver acceptance record</span><strong>I have read and agree to the TRYP Driver Agreement.</strong><strong>Electronic acceptance: ☑</strong><strong>Driver Name: ______________________________</strong><strong>ID / Registration Number: ___________________</strong><strong>Vehicle Registration: ________________________</strong><strong>TRYP Driver ID: _____________________________</strong><strong>Signature / Electronic Acceptance: ____________</strong><strong>Date: ______________________________________</strong><strong>Agreement Version: _________________________</strong></div>}</section>)}</div>
    <div class="agreement-publication-note"><strong>TRYP’s contract stack</strong><p>This Agreement should be read with the <a href="/driver-terms/">Driver Terms</a>, <a href="/driver-code/">Driver Code of Conduct</a>, <a href="/safety-policy/">Safety & Emergency Response Policy</a>, Driver Privacy Notice, Vehicle Requirements, Earnings & Commission Schedule and other applicable commercial terms.</p><p>Before acceptance, confirm the operating entity, worker classification analysis, licensing process, App functionality, fee schedule, insurance structure, tax treatment, data-protection controls and dispute process.</p><div class="actions"><a class="button button-red" href="/driver-terms/">Read Driver Terms <span>→</span></a><a class="button button-outline" href="/driver-code/">Read Driver Code <span>↗</span></a><a class="button button-outline" href="/safety-policy/">Read Safety Policy <span>↗</span></a><a class="button button-outline" href="/drive/">Return to driver page <span>↗</span></a></div></div>
  </ContentLayout>
</SiteLayout>
